@misc{Car16,
  title = {On the \'Etale Homotopy Type of Higher Stacks},
  author = {Carchedi, David},
  year = 2016,
  month = jul,
  number = {arXiv:1511.07830},
  eprint = {1511.07830},
  primaryclass = {math.AG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.1511.07830},
  url = {http://arxiv.org/abs/1511.07830},
  urldate = {2026-06-29},
  abstract = {A new approach to \'etale homotopy theory is presented which applies to a much broader class of objects than previously existing approaches, namely it applies not only to all schemes (without any local Noetherian hypothesis), but also to arbitrary higher stacks on the \'etale site of such schemes, and in particular to all algebraic stacks. This approach also produces a more refined invariant, namely a pro-object in the infinity category of spaces, rather than in the homotopy category. We prove a profinite comparison theorem at this level of generality, which states that if \$\textbackslash mathcal\textbraceleft X\textbraceright\$ is an arbitrary higher stack on the \'etale site of affine schemes of finite type over \$\textbackslash mathbb\textbraceleft C\textbraceright,\$ then the \'etale homotopy type of \$\textbackslash mathcal\textbraceleft X\textbraceright\$ agrees with the homotopy type of the underlying stack \$\textbackslash mathcal\textbraceleft X\textbraceright\_\textbraceleft top\textbraceright\$ on the topological site, after profinite completion. In particular, if \$\textbackslash mathcal\textbraceleft X\textbraceright\$ is an Artin stack locally of finite type over \$\textbackslash mathbb\textbraceleft C\textbraceright\$, our definition of the \'etale homotopy type of \$\textbackslash mathcal\textbraceleft X\textbraceright\$ agrees up to profinite completion with the homotopy type of the underlying topological stack \$\textbackslash mathcal\textbraceleft X\textbraceright\_\textbraceleft top\textbraceright\$ of \$\textbackslash mathcal\textbraceleft X\textbraceright\$ in the sense of Noohi. In order to prove our comparison theorem, we provide a modern reformulation of the theory of local systems and their cohomology using the language of \$\textbackslash infty\$-categories which we believe to be of independent interest.},
  archiveprefix = {arXiv},
  keywords = {burndown:published-title-search,intake:sorted-pdfs,Mathematics - Algebraic Geometry,Mathematics - Algebraic Topology,Mathematics - Category Theory,pdf-needs-review,workflow:add-by-identifier,workflow:dedupe-and-merge},
