@article{LW22,
  title = {Elliptic {{K3 Surfaces}} at {{Infinite Complex Structure}} and Their {{Refined Kulikov}} Models},
  author = {Lee, Seung-Joo and Weigand, Timo},
  year = 2022,
  month = sep,
  journal = {Journal of High Energy Physics},
  volume = {2022},
