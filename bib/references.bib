@phdthesis{Fio19,
  title = {Matrix {{Factorizations}} for {{Quasi-Coherent Sheaves}} of {{Categories}}},
  author = {{di Fiore}, Carlos Ignacio},
  year = 2019,
  month = aug,
  pages = {47 pages},
  doi = {10.6082/UCHICAGO.2022},
  url = {https://knowledge.uchicago.edu/records/vqx2p-4d276},
  urldate = {2026-06-29},
  abstract = {We explore some similarities between the theory of D-modules and that of quasi-coherent sheaves of categories. The original motivation is to better understand several results on the literature that relates vanishing cycles with some invariants of the category of matrix factorizations like its periodic cyclic homology or its etale cohomology. We propose the following explanation: given a function f:X---{$>$} A\textasciicircum 1, the category of matrix factorizations MF(X,f) can be thought as a higher categorical version of vanishing cycles for the sheaf of categories corresponding to Perf(X). Here, the 2-periodic structure on matrix factorizations corresponds to the monodromy of vanishing cycles. A second goal is to find the general phenomena behind the work of A. Preygel that uses\textasciitilde derived algebraic geometry to construct MF(X,f) from a cohomological operation of degree 2 on Coh(X\_0). We interpret this as the microlocalization of Perf(X) over T\textasciicircum *\_0A\textasciicircum 1 and extend it to arbitrary quasi-coherent sheaves of categories over smooth schemes. To realize the above we need the theory of quasi-coherent sheaves of categories developed by D.Gaitsgory, J.Lurie, B.Toen and G.Vessozzi. The basic formalism is quite recent and contains pushforward and pullback. We slightly modify it to get an extraordinary pullback for complete intersection morphisms. We also introduce the matrix factorizations functor. The main result of this thesis is a comparison between the usual and the extraordinary pullback. In rough terms, via Koszul duality, the extraordinary pullback localize over a conormal bundle and the usual pullback correspond to the part supported on the zero section. We study the case of the closed immersion of a point in a smooth scheme. This defines for every quasi-coherent sheaf of categories its punctual singular support, analogous to the singular support of a D-module. In the end we give a deformation theory interpretation. This is part of joint work with G. Stefanich. In future work we will define and study the global singular support of a quasi-coherent sheaf of categories. This is a closed conical subset of the cotangent bundle that measures the directions on which the sheaf is proper and smooth.},
  collaborator = {Beilinson, Alexander and Rozenblyum, Nick},
  copyright = {Distribution License, \copyright{} 2019 Carlos Ignacio di Fiore},
  langid = {english},
  school = {University of Chicago},
  keywords = {FOS: Mathematics,intake:sorted-pdfs,Mathematics,Matrix Factorizations,Sheaves of categories,Vanishing cycles},
  timestamp = {2026-06-30T06:41:09Z},
  file = {diFiore_uchicago_0330D_14994.pdf:/home/dzack/Zotero/storage/8ZLQDG9N/local-write-api-1782660769406-R8LW4YPZ_diFiore_uchicago_0330D_14994.pdf:application/pdf;598WKIBJ_content_list.json:/home/dzack/Zotero/storage/FA7237LH/local-write-api-1783193871780-598WKIBJ_content_list.json:application/json;598WKIBJ_extracted.md:/home/dzack/Zotero/storage/HDKVKAG5/local-write-api-1783193872050-598WKIBJ_extracted.md:text/markdown;598WKIBJ_middle.json:/home/dzack/Zotero/storage/L67IQQ7G/local-write-api-1783193871916-598WKIBJ_middle.json:application/json}
