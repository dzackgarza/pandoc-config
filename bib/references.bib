  urldate = {2025-08-29},
  abstract = {Let (C, {$\iota$}) be a stable curve with an involution. Following a classical construction one can define its Prym variety P , which in this case turns out to be a semiabelian group variety and usually not complete. In this paper we study the question whether there are ``good'' compactifications of P in analogy to compactified Jacobians. The answer to this question depends on whether we consider degenerations of principally polarized Prym varieties or degenerations with the induced (non-principal) polarization. We describe degeneration data of such degenerations. The main application of our theory lies in the case of degenerations of principally polarized Prym varieties where we ask whether such a degeneration depends on a given one-parameter family containing (C, {$\iota$}) or not. This allows us to determine the indeterminacy locus of the Prym map.},
  langid = {english},
  keywords = {abelian-varieties,algebraic-curves,degenerations,moduli,theta-functions},
  timestamp = {2026-06-30T18:04:00Z},
  file = {ABH02_middle.json:/home/dzack/Zotero/storage/E3BV8R2W/Alexeev et al. - 2002 - Degenerations of Prym varieties_middle.json:application/json;PDF:/home/dzack/Zotero/storage/EIACEZIN/Alexeev et al. - 2002 - Degenerations Of Prym Varieties.pdf:application/pdf;ABH02_content_list.json:/home/dzack/Zotero/storage/JELJTGJY/Alexeev et al. - 2002 - Degenerations of Prym varieties_content_list.json:application/json;ABH02_extracted.md:/home/dzack/Zotero/storage/XPYQ4PJ3/Alexeev et al. - 2002 - Degenerations of Prym varieties.md:text/markdown}
