@misc{Zak16a,
  title = {The \${{K}}\$-Theory of Assemblers},
  author = {Zakharevich, Inna},
  year = 2016,
  month = sep,
  doi = {10.48550/arXiv.1401.3712},
  url = {http://arxiv.org/abs/1401.3712},
  urldate = {2022-06-06},
  abstract = {In this paper we introduce the notion of an assembler, which formally encodes "cutting and pasting" data. An assembler has an associated \$K\$-theory spectrum, in which \$\textbackslash pi\_0\$ is the free abelian group of objects of the assembler modulo the cutting and pasting relations, and in which the higher homotopy groups encode further geometric invariants. The goal of this paper is to prove structural theorems about this \$K\$-theory spectrum, including analogs of Quillen's localization and d\textbackslash 'evissage theorems. We demonstrate the uses of these theorems by analysing the assembler associated to the Grothendieck ring of varieties and the assembler associated to scissors congruence groups of polytopes.},
  keywords = {algebraic-k-theory,category-theory,homotopy-theory,k-theory,scissors-congruences},
  timestamp = {2026-06-28T19:14:35Z},
