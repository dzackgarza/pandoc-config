  year = 2020,
  doi = {10.48550/arXiv.2010.08226},
  url = {https://arxiv.org/abs/2010.08226},
  abstract = {We study the non-klt locus of singularities of pairs. We show that given a pair (X,B) and a projective morphism XZ with connected fibres such that -(K\textsubscript{X}+B) is nef over Z, the non-klt locus of (X,B) has at most two connected components near each fibre of XZ. This was conjectured by Hacon and Han. In a different direction we answer a question of Mark Gross on connectedness of the non-klt loci of certain pairs. This is motivated by constructions in Mirror Symmetry.},
  keywords = {birational-geometry,fibrations,klt-singularities,minimal-model-program,singularities},
