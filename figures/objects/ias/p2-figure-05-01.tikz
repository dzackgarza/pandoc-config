% P2 integral-affine surgery drawing. Source: authored IAS notes; Eng18, Defs. 4.2-4.4; AE23, Def. 3.7.
\begin{scope}[scale=0.4]
\begin{scope}[on background layer]
    \draw[lattice grid,step=1cm] (-1,-1) grid (11,11);
    \end{scope}
    \begin{scope}
    \node [distinguished point, label=left:$p_{13}$] (0) at (0, 0) {};
    \node [distinguished point, label=above:$p_{12}$] (1) at (0, 10) {};
    \node [distinguished point, label=right:$p_{23}$] (2) at (10, 0) {};
    \node [boundary point, scale=0.5] (3) at (5, 0) {};
    \node [boundary point, scale=0.5] (4) at (6, 0) {};
    \node [ias singularity] (5) at (5, 1) {};
    \end{scope}
    \begin{scope}[on edge layer]
    \draw (0) edge["$e_1$", near start] node[right, near start] {$-1$} (1);
    \draw (1) edge["$e_2$"] node[below] {$-1$}  (2);
    \draw (0) edge["$e_3$"', midway] node[above, midway] {$0$} (3);
    \draw (4) edge["$e_3$"', midway] (2);
    \draw [ias cut] (3) to (5);
    \draw [ias cut] (4) to (5);
    \end{scope}
\end{scope}
