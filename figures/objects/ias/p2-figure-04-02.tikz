\node [distinguished point, label=above left:$q_{12}^1$] (n1a) at (7, 7) {};
\node [distinguished point, label=above right:$q_{12}^2$] (n1b) at (9, 7) {};
\node [distinguished point, label=left:$q_{13}^1$] (sw1a) at (1, 1) {};
\node [distinguished point, label=below  left:$q_{13}^3$] (sw1b) at (1, 0) {};
