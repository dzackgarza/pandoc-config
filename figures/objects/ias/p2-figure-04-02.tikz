\begin{scope}[on edge layer]
\draw[shorten >=-0.5cm,shorten <=-0.5cm]  (sw1a) to node[label=left:$C_1$, label=right:$1$] {} (n1a);
\draw[shorten >=-0.5cm,shorten <=-0.5cm]  (n1b) to node[label=right:$C_2$, label=left:$1$] {} (se1a);
\draw[shorten >=-0.5cm,shorten <=-0.5cm]  (se1b) to node[label=below:$C_3$, label=above:$1$] {} (sw1b);
%
\draw[shorten >=-1cm,shorten <=-1cm] ($(n1a.south) + (0, 0.2em)$) to[bend right=20] node[above, yshift=2em] {$E_{12}$} node[below] {$1$} ($(n1b.south) + (0, 0.2em)$);
\draw[shorten >=-1cm,shorten <=-1cm] ($(se1a.center) - (0.2em, 0)$) to[bend right=20] node[right, xshift=2em] {$E_{23}$} node[left] {$1$} ($(se1b.center) - (0.2em, 0)$);
\draw[shorten >=-1cm,shorten <=-1cm] ($(sw1b.east) - (0.2em, 0)$) to[bend right=20] node[left, xshift=-2em] {$E_{13}$} node[right] {$1$} ($(sw1a.east) - (0.2em, 0)$);	\end{scope}
