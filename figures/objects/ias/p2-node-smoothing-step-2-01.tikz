% P2 integral-affine surgery drawing. Source: authored IAS notes; Eng18, Defs. 4.2-4.4; AE23, Def. 3.7.
\begin{scope}[scale=0.4]
\begin{scope}[on background layer]
    \draw[lattice grid,step=1cm] (-1,-1) grid (11,11);
 \end{scope}
	\begin{scope}
		\node [boundary point, label=left:$p_{13}$] (0) at (0, 0) {};
		\node [distinguished point, label=above:$p_{12}$] (1) at (0, 10) {};
		\node [boundary point, label=right:$p_{23}$] (2) at (10, 0) {};
        \node [ias singularity] (3) at (1, 1) {};
        \node [ias singularity] (4) at (8, 1) {};
	\end{scope}
	\begin{scope}[on edge layer]
        \draw (0) edge["$e_1=e_3=e_2$"] node[right, near start] {9} (1);
		\draw (1) edge["$e_2=e_1=e_3$"] node[below] {9} (2);
		\draw (0) edge["$e_3=e_1=e_2$"'] node[above, near start] {9}  (2);
        \draw [ias cut] (0) to (3);
        \draw [ias cut] (2) to (4);
	\end{scope}
\end{scope}
