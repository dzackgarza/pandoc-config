% The Symington polygon P(l) of the 0-cusp (18,0,0)_1 = U + E_8^2 of
% F_{(2,2,0)} [AEGS §4.2, Fig. 12], cut open along p_19 p_2: sides 2..18, and
% Symington surgeries with the roots 1 and 19 on the sides 4 and 16, singular
% points p_1 and p_20. The corners p_2 and p_19 have charge 2: the I_2
% singularity of [ABE22, Fig. 4] splits into two I_1 that collide with the
% corners. l_i = lambda . alpha_i for the Vinberg roots alpha_i
% (objects/coxeter/vinberg-18-0-0).
% Default instance: the dissertation figure, l_1..l_19 =
% (2,2,2,2,2,1,2,1,2,1,2,1,2,1,2,2,2,2,2).
\setell{1}{2,2,2,2,2,1,2,1,2,1,2,1,2,1,2,2,2,2,2}
\symingtonpolygon[first=2, last=19, charges={2/2, 19/2}]
  {2/0/1/w/0, 3/-1/4/h/0, 4/-1/3/s/1, 5/-2/5/h/0, 6/-1/2/w/0, 7/-2/3/h/0,
   8/-1/1/w/0, 9/-2/1/h/0, 10/-1/0/w/0, 11/-2/-1/h/0, 12/-1/-1/w/0,
   13/-2/-3/h/0, 14/-1/-2/w/0, 15/-2/-5/h/0, 16/-1/-3/s/19, 17/-1/-4/h/0,
   18/0/-1/w/0}
  {4/1/-1/2/a/1, 16/19/1/2/b/20}
\draw[ias boundary, dashed, draw=dzg muted] (-p2) -- (-p19);
