\begin{scope}[on edge layer]
\draw (0) edge["$C_1$"] node[below] {$0$} 
(2);
\draw (3) edge["$C_2$"] node[below] {$0$}(1);
\draw (5) edge["$C_3$", midway] node[above] {$0$} (4);
\draw [exceptional curve] (ccc) to node[below left, near start] {$E_1$} node[above, near start] {$-1$} (ccc);
\draw [exceptional curve] (ddd) to node[above right, near start] {$E_2$} node[below left, near start] {$-1$} (ddd);
\draw [exceptional curve] (eee) to node[above left, near start] {$E_3$} node[below right, near start] {$-1$} (eee);
