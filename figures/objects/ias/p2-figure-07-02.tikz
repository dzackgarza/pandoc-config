% P2 integral-affine surgery drawing. Source: authored IAS notes; Eng18, Defs. 4.2-4.4; AE23, Def. 3.7.
\begin{scope}[scale=1]
\begin{scope}
\node [inner sep=0pt] (0) at (1, 0) {};
\node [inner sep=0pt] (1) at (9, 0) {};
\node [inner sep=0pt] (2) at (6, 5) {};
\node [inner sep=0pt] (3) at (4, 5) {};
\node [inner sep=0pt] (4) at (1, 1) {};
\node [inner sep=0pt] (5) at (9, 1) {};
\node [distinguished point, label=above:$q_{12}$] (6) at (5, 4) {};
\node [distinguished point, label=above:$q_{23}$] (7) at (2, 1) {};
\node [distinguished point, label=above:$q_{13}$] (8) at (8, 1) {};
\node[nontoric blowup] (ccc) at (4, 1) {};
