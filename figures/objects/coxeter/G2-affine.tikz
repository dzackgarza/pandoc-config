% The Coxeter diagram of the affine group G~_2 [Humphreys, Reflection Groups
% and Coxeter Groups, §2.5], drawn with multiple edges: an edge of weight m is
% m-2 lines, so the edge 1-2 of weight 6 is a quadruple edge; root 0 is the
% affine root, joined to 1 by a simple edge.
\node[inner sep=0pt] {\tikzset{inner sep=.3333em}\begin{dynkinDiagram}[label, arrows=false, edge length=1.75cm, labels={0,1,2}]A{***}
    \dynkinQuadrupleEdge 23
  \end{dynkinDiagram}};
