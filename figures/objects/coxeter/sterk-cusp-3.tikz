% The Coxeter diagram of the 0-cusp eta_3 of F_{En,2} (Sterk 1991, diagram III;
% the dissertation numbers the cusps as Sterk does).
% Roots: dzack_research.preamble.sterk, Sterk.sterk_roots()["Sterk_3"], the
% folds of the (18,2,0) roots under J_3 (objects/coxeter/sterk-cusp-cover-3).
% Root i is the (i+1)-th root there and is labelled r_i, as in
% 900-five-cusps.md. Layout: _STERK_DIAGRAM_LAYOUTS["Sterk_3"], scaled by 1/4.
% From the Gram matrix (white: norm -2; black: norm -4): 0, 8 have norm -2.
% 1..7 simple chain, 4 -- 9 simple; 0 -- 1, 0 -- 10, 7 -- 8, 8 -- 11 weight 4;
% 10 -- 11 bold.
% Roots -0..-11, labelled r_i.
\coxeterlabels{r}
\coxeterroots{0/white/{0,-1}/180, 1/black/{0,1}/180, 2/black/{0,2}/180,
  3/black/{0,3}/180, 4/black/{0,4}/135, 5/black/{1,4}/90,
  6/black/{2,4}/90, 7/black/{3,4}/90, 8/white/{5,4}/45, 9/black/{1,3}/0,
  10/black/{1.5,0.5}/315, 11/black/{3.5,2.5}/315}
\coxeterchain{3}{1}{7}
\coxeteredges{3}{(-4) -- (-9)}
\coxeteredges{4}{(-0) -- (-1) (-0) -- (-10) (-7) -- (-8) (-8) -- (-11)}
\coxeteredges{infinity}{(-10) -- (-11)}
