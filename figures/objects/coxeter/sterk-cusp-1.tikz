% The Coxeter diagram of the 0-cusp eta_1 of F_{En,2} (Sterk 1991, diagram I;
% the dissertation numbers the cusps as Sterk does).
% Roots: dzack_research.preamble.sterk, Sterk.sterk_roots()["Sterk_1"], the
% folds of the (18,2,0) roots under J_1 (objects/coxeter/sterk-cusp-cover-1).
% Root i is the (i+1)-th root there and is labelled r_i, as in
% 900-five-cusps.md. Layout: _STERK_DIAGRAM_LAYOUTS["Sterk_1"], scaled by 1/2.
% From the Gram matrix: all norm -4 (black). 0..7 a cycle of simple edges;
% 2 -- 11 and 6 -- 8 simple; 8 -- 9 -- 10 -- 11 bold (inner products 4).
% 9, 10 have divisibility 2.
% Roots -0..-11, labelled r_i.
\coxeterlabels{r}
\coxeterroots{0/black/{0,0}/135, 1/black/{2,0}/90, 2/black/{4,0}/45,
  3/black/{4,-2}/0, 4/black/{4,-4}/315, 5/black/{2,-4}/270,
  6/black/{0,-4}/225, 7/black/{0,-2}/180, 8/black/{1,-3}/135,
  9/black/{1.625,-2.375}/135, 10/black/{2.25,-1.75}/135, 11/black/{3,-1}/135}
\coxeterchain{3}{0}{7}
\coxeteredges{3}{(-7) -- (-0) (-2) -- (-11) (-6) -- (-8)}
\coxeteredges{infinity}{(-8) -- (-9) -- (-10) -- (-11)}
