% The Coxeter diagram for the moduli F_4 of degree-4 K3 surfaces: 24 roots of
% square -2 spanning U+E_8^2+<-4> (rank 19, signature (1,18), discriminant Z/4,
% computed from this Gram matrix; roots of square -4 would span a lattice of
% discriminant (Z/2)^18+Z/8). The diagram for F_2 is
% objects/coxeter/vinberg-19-1-1.
% The 16-cycle -0..-15 around the square [0,6]^2; -16..-19 joined to the
% corners -0, -4, -8, -12 and placed on the diagonals; -20, -23 on the segment
% between the midpoints of the edges 10-11 and 1-2, -21, -22 on the segment
% between the midpoints of the edges 9-10 and 2-3.
% Roots -0..-23, labelled r_i.
\coxeterlabels{r}
\coxetersquare{6}{4}{0}{sw}{white}{white}
\coxeterroot{16}{white}{$(-0)!1/8!(-8)$}{below right}
\coxeterroot{17}{white}{$(-4)!1/8!(-12)$}{below left}
\coxeterroot{18}{white}{$(-8)!1/8!(-0)$}{above left}
\coxeterroot{19}{white}{$(-12)!1/8!(-4)$}{above right}
\coordinate (-10-11) at ($(-10)!0.5!(-11)$);
\coordinate (-1-2) at ($(-1)!0.5!(-2)$);
\coordinate (-9-10) at ($(-9)!0.5!(-10)$);
\coordinate (-2-3) at ($(-2)!0.5!(-3)$);
\coxeterroot{23}{white}{$(-10-11)!1/3!(-1-2)$}{above left}
\coxeterroot{20}{white}{$(-10-11)!2/3!(-1-2)$}{below left}
\coxeterroot{22}{white}{$(-9-10)!1/3!(-2-3)$}{above right}
\coxeterroot{21}{white}{$(-9-10)!2/3!(-2-3)$}{below right}
\coxeteredges{3}{(-0) -- (-16) (-4) -- (-17) (-8) -- (-18) (-12) -- (-19)
  (-16) -- (-23) (-16) -- (-21) (-17) -- (-20) (-17) -- (-22)
  (-18) -- (-23) (-18) -- (-21) (-19) -- (-22) (-19) -- (-20)}
\coxeteredges{infinity}{
  (-23) -- node[vertex label, midway, right] {$\infty$} (-20)
  (-22) -- node[vertex label, midway, left] {$\infty$} (-21)}
