% The quotients of a K3 surface X by the Klein four-group generated by the
% del Pezzo involution (X -> Y), the Enriques involution (X -> Z) and the
% Nikulin involution (X -> Z'), all over W = X/G: the stable pairs with their
% divisors.
% Source: the Enriques paper, the version for pairs of equation (basic)
% (writing/sources/en.tex; also enriques_paper/en-revised-Oct05.tex,
% en-revised-Oct12-Phil.tex, en-revised-Oct12b-Phil.tex). The surfaces
% version: klein-quotients.
% Points: -diagram, the tikz-cd diagram.
\node[inner sep=0pt] (-diagram) {\begin{tikzcd}[ampersand replacement=\&]
  (X,D+\epsilon R) \arrow{d}[swap]{\pi} \arrow[swap]{r}{\psi}
      \arrow[bend left=20]{rr}{\psi'}
    \& (Z,D_Z + \epsilon R_Z) \arrow{d}[swap]{\rho}
    \& (Z',D_{Z'} + \epsilon R_{Z'}) \arrow{dl}{\rho'} \\
  (Y,C +\tfrac{1+\epsilon}{2}B) \arrow[swap]{r}{\varphi}
    \& (W,C_W + \tfrac{1+\epsilon}{2}B_W)
\end{tikzcd}};
