% The quotients of a K3 surface X by the Klein four-group generated by the
% del Pezzo involution (X -> Y), the Enriques involution (X -> Z) and the
% Nikulin involution (X -> Z'), all over W = X/G: the surfaces.
% Source: the Enriques paper, equation (basic) (writing/sources/en.tex; also
% enriques_paper/en-revised-Oct05.tex, en-revised-Oct12-Phil.tex,
% en-revised-Oct12b-Phil.tex). The pairs version: klein-quotients-pairs.
% Points: -diagram, the tikz-cd diagram.
\node[inner sep=0pt] (-diagram) {\begin{tikzcd}[ampersand replacement=\&]
  X \arrow{d}[swap]{\pi} \arrow[swap]{r}{\psi} \arrow[bend left=20]{rr}{\psi'}
    \& Z \arrow{d}[swap]{\rho} \& Z' \arrow{dl}{\rho'} \\
  Y \arrow[swap]{r}{\varphi} \& W
\end{tikzcd}};
