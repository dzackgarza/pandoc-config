% The 2-sphere S^2, radius 1 about the origin, drawn with its equator and a
% meridian, back halves dashed.
% Points: -center.
\coordinate (-center) at (0,0);
\shade[ball color=dzg region, opacity=0.2] (0,0) circle (1);
\draw[black] (-1,0) arc (180:360:1 and 0.5);
\draw[black] (0,1) arc (90:270:0.5 and 1);
\draw[black, dashed] (-1,0) arc (180:0:1 and 0.5);
\draw[black, dashed] (0,1) arc (90:-90:0.5 and 1);
\draw[black] (0,0) circle (1);
\spacelabel{0,-1.4}{$S^2$}
