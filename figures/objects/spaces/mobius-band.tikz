% The Moebius band [0,2pi] x [-1/2,1/2] / (0,t) ~ (2pi,-t), embedded as
% ((1 + t/2 cos(s/2)) cos s, (1 + t/2 cos(s/2)) sin s, t/2 sin(s/2)), with its
% core circle t = 0; a pgfplots axis.
\begin{axis}[hide axis, view={40}{40}]
  \addplot3[surf, colormap/cool, shader=faceted interp, point meta=x,
      samples=40, samples y=5, z buffer=sort, domain=0:360, y domain=-0.5:0.5]
    ({(1+0.5*y*cos(x/2))*cos(x)},
     {(1+0.5*y*cos(x/2))*sin(x)},
     {0.5*y*sin(x/2)});
  \addplot3[distinguished curve, samples=50, domain=-145:180, samples y=0]
    ({cos(x)}, {sin(x)}, {0});
\end{axis}
