% A stable curve of the stratum d = 8 of \overline{M}_2 (Deligne-Mumford):
% two genus-1 vertices, one edge (Delta_1), 1 node. Hobby splines through the listed points, one path per
% component; a self-node is a loop of four points.
% Stable graphs of genus 2 enumerated in Harris-Morrison, "Moduli of curves",
% Sec. 3.C; the stratum is named by the divisor d of 24 of
% objects/moduli/m2-strata.json.
% Points: -box the bounding box. Keys: genus labels.
\begin{scope}[local bounding box=-box]
  \draw[curve component] (-1,0.5) to[curve through={(-0.4,0.12) .. (0,0) .. (0.4,-0.12)}] (1,-0.5);
  \draw[curve component, yscale=-1] (-1,0.5) to[curve through={(-0.4,0.12) .. (0,0) .. (0.4,-0.12)}] (1,-0.5);
  \genuslabel{left}{-0.95,0.55}{1}
  \genuslabel{right}{0.95,0.55}{1}
\end{scope}
