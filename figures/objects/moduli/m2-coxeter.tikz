% The Coxeter diagram whose nonempty subdiagrams, up to its S_3 symmetry,
% index the strata of \overline{M}_2 (objects/moduli/m2-strata): stratum
% d = 2^k * 3^c is k of the three black vertices and c of the white centre.
% A white centre joined to three black vertices by weight-4 edges.
% Points: -c the centre, -o1, -o2, -o3 the black vertices.
\node[vertex=white] (-c) at (0,0) {};
\foreach \t [count=\i] in {90, 210, 330} {
  \node[vertex=black] (-o\i) at (\t:1.15) {};
  \scoped[on edge layer] \draw[coxeter edge=4] (-c) -- (-o\i);
}
