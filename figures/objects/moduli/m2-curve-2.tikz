% A stable curve of the stratum d = 2 of \overline{M}_2 (Deligne-Mumford):
% two genus-0 vertices, one edge, a loop at each (dumbbell), 3 nodes. Hobby splines through the listed points, one path per
% component; a self-node is a loop of four points.
% Stable graphs of genus 2 enumerated in Harris-Morrison, "Moduli of curves",
% Sec. 3.C; the stratum is named by the divisor d of 24 of
% objects/moduli/m2-strata.
% Points: -box the bounding box. Keys: genus labels.
\begin{scope}[local bounding box=-box]
  \draw[curve component] (-1.4,-0.2)
    to[curve through={(-0.9,0) .. (-0.6,0.35) .. (-0.8,0.55) .. (-1,0.35) .. (-0.7,0.02)
                      .. (0,-0.25)}] (0.8,-0.55);
  \draw[curve component, xscale=-1] (-1.4,-0.2)
    to[curve through={(-0.9,0) .. (-0.6,0.35) .. (-0.8,0.55) .. (-1,0.35) .. (-0.7,0.02)
                      .. (0,-0.25)}] (0.8,-0.55);
  \genuslabel{left}{-1.4,-0.2}{0}
  \genuslabel{right}{1.4,-0.2}{0}
\end{scope}
