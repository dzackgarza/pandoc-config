% The stable graph of the stratum d = 4 of \overline{M}_2 (Deligne-Mumford):
% genus-1 vertex, edge, genus-0 vertex with a loop, 2 nodes.
% Stable graphs of genus 2 enumerated in Harris-Morrison, "Moduli of curves",
% Sec. 3.C; the stratum is named by the divisor d of 24 of
% objects/moduli/m2-strata.
% Points: -v1, -v2 the vertices; -box the bounding box. Keys: genus labels.
\begin{scope}[local bounding box=-box]
  \dualloop{0.45,0}{right}
  \dualvertex{-v1}{-0.45,0}{1}{left}
  \dualvertex{-v2}{0.45,0}{0}{below left}
  \draw (-v1) -- (-v2);
\end{scope}
