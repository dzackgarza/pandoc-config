% A stable curve of the stratum d = 3 of \overline{M}_2 (Deligne-Mumford):
% two genus-0 vertices, three edges (theta), 3 nodes. Hobby splines through the listed points, one path per
% component; a self-node is a loop of four points.
% Stable graphs of genus 2 enumerated in Harris-Morrison, "Moduli of curves",
% Sec. 3.C; the stratum is named by the divisor d of 24 of
% objects/moduli/m2-strata.json.
% Points: -box the bounding box. Keys: genus labels.
\begin{scope}[local bounding box=-box]
  \draw[curve component] (-1.2,0.3)
    to[curve through={(-0.8,0) .. (-0.4,-0.3) .. (0,0) .. (0.4,0.3) .. (0.8,0)}] (1.2,-0.3);
  \draw[curve component, yscale=-1] (-1.2,0.3)
    to[curve through={(-0.8,0) .. (-0.4,-0.3) .. (0,0) .. (0.4,0.3) .. (0.8,0)}] (1.2,-0.3);
  \genuslabel{left}{-1.2,0.3}{0}
  \genuslabel{left}{-1.2,-0.3}{0}
\end{scope}
