% F_2, K3 surfaces of degree 2: one 0-cusp -P [Sca87 §6]. 1-cusps named by the
% root system of the boundary lattice (Scattone); the unimodular D_16 lattice
% is D_16^+.
% Points: 0-cusp -P; 1-cusps -A1E8E8, -E7D10, -A1D16, -A17.
\foreach \n/\y/\lat in {A1E8E8/1.5/A_1E_8^2, E7D10/0.5/E_7D_{10},
    A1D16/-0.5/A_1D_{16}, A17/-1.5/A_{17}}
  {\bbcusp{cusp1}{-\n}{0,\y}{\lat}{}{}{}}
\bbcusp{cusp0}{-P}{3.6,0}{A_1 \oplus U \oplus E_8^2}{above}{}{\eta}
\bbincidences{-P/-A1E8E8/1, -P/-E7D10/1, -P/-A1D16/1, -P/-A17/1}
\bbbrace{-0.7}{0.7}{-1.5}{(17,1,1)_0}
\bbbrace{2.6}{4.6}{-1.5}{(19,1,1)_1}
