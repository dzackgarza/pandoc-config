\begin{tikzpicture}[scale=0.9]
  % A planar projection of a triangulated integral-affine sphere.
  \draw[ias boundary] (0, 0) circle (4);

  % Rim vertices on a regular octagon.
  \foreach \n [count=\i from 0] in {E, NE, N, NW, W, SW, S, SE}
    \coordinate (\n) at (\i*45:3.75);

  \coordinate (a) at (-1.45, 2.05);
  \coordinate (b) at (1.45, 2.05);
  \coordinate (c) at (2.05, 0.25);
  \coordinate (d) at (1.35, -1.9);
  \coordinate (e) at (-1.35, -1.9);
  \coordinate (f) at (-2.05, 0.25);
  \coordinate (O) at (0, 0.15);

  % Triangulation.
  \foreach \p/\q in {N/a, N/b, NE/b, NE/c, E/c, E/d, SE/d, SE/S, S/e, SW/e, SW/W,
      W/f, NW/f, NW/N, NW/a, a/b, b/c, c/d, d/e, e/f, f/a, a/O, b/O, c/O, d/O,
      e/O, f/O}
    \draw[ias edge] (\p) -- (\q);

  % A local fan at the central vertex.
  \foreach \q in {a, b, c, d, e, f}
    \draw[fan ray, shorten >=10pt] (O) -- (\q);
  \node[stratum, fill=dzg accent, label={[text=dzg accent]below right:$\Sigma_p$}]
    at (O) {};

  % Representative integral-affine singularities.
  \foreach \p in {(-2.55, 1.25), (2.55, 1.05), (2.05, -2.15), (-1.95, -2.2)}
    \node[ias singularity] at \p {};

  \node[above] at (0, 4.15) {$S^2$};
\end{tikzpicture}
