\begin{tikzpicture}[scale=0.4]
  \scoped[on background layer] \draw[lattice grid] (-1,-1) grid (11,11);
  \node[vertex=white, label=left:$p_{13}$] (p13) at (0,0) {};
  \node[vertex=black, label=above:$p_{12}$] (p12) at (0,10) {};
  \node[vertex=black, label=right:$p_{23}$] (p23) at (10,0) {};
  \node[ias singularity] (s) at (1,1) {};
  \begin{scope}[on edge layer]
    \draw[ias boundary] (p13.center) -- node[left] {$e_1=e_3$}
      node[right, near start] {$2$} (p12.center);
    \draw[ias boundary] (p12.center) -- node[above right] {$e_2$}
      node[below] {$1$} (p23.center);
    \draw[ias boundary] (p13.center) -- node[below] {$e_3=e_1$}
      node[above, near start] {$2$} (p23.center);
    \draw[dashed] (p13.center) -- (s.center);
  \end{scope}
\end{tikzpicture}
