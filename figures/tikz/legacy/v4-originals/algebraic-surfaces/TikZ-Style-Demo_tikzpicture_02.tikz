% TikZ Diagram from V4 Thesis
% Source: dev/tex/packages/TikZ-Style-Demo.tex
% Type: tikzpicture
% Category: algebraic-surfaces
% Index: 2

\begin{tikzpicture}
  \foreach \i in {1,...,4} \node[vertex=white] (a\i) at (\i-1,0) {};
  \scoped[on edge layer]
    \draw[coxeter edge=3] (a1.center) -- (a2.center) -- (a3.center) -- (a4.center);
  \node[below=0.5cm] at (1.5,0) {$A_4$ surface};
\end{tikzpicture}
