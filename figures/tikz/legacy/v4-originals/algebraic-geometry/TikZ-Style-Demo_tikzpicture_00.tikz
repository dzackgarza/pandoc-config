% TikZ Diagram from V4 Thesis
% Source: dev/tex/packages/TikZ-Style-Demo.tex
% Type: tikzpicture
% Category: algebraic-geometry
% Index: 0

\begin{tikzpicture}[scale=0.8]
  \fill[polygon region] (0,0) rectangle (3,3);
  \draw (0,0) rectangle (3,3);
  \foreach \x in {0,...,3}
    \foreach \y in {0,...,3}
      \node[lattice point] at (\x,\y) {};
  \foreach \p in {(0,0), (3,3)} \node[boundary point] at \p {};
\end{tikzpicture}
