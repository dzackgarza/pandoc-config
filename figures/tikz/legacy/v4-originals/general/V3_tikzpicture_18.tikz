% The symmetries d (diagonal reflection), h (horizontal reflection) and
% r (rotation by pi) of the Vinberg diagram of (18,2,0).
\begin{tikzpicture}[scale=0.9]
  \pic (D) {object=coxeter/vinberg-18-2-0};
  \draw[fold axis] (-0.5,-0.5) -- (4.5,4.5);
  \draw[fold] (2,1) -- (1,2);
  \node at (2,-1) {d};
  \begin{scope}[shift={(6,0)}]
    \pic (H) {object=coxeter/sterk-cusp-cover-4};
    \node at (2,-1) {h};
  \end{scope}
  \begin{scope}[shift={(12,0)}]
    \pic (R) {object=coxeter/sterk-cusp-cover-1};
    \node at (2,-1) {r};
  \end{scope}
\end{tikzpicture}
