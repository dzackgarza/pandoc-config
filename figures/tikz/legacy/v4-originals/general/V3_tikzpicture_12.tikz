% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V3.tex
% Type: tikzpicture
% Category: general
% Index: 12

% The Vinberg diagram of (18,2,0) with its eight white boundary roots
% highlighted, and Sterk's diagram V with its roots labelled l'_1..l'_12.
\begin{tikzpicture}
  \pic (L) [root labels=ell] {vinberg 18 2 0};
  \scoped[on background layer]
    \foreach \n in {2,4,...,16} \draw[parabolic] (L\n.center) -- (L\n.center);
  \begin{scope}[shift={(7,0)}]
    \pic (R) {sterk=5};
    \foreach \n/\a/\t in {1/135/1, 2/90/2, 3/45/3, 4/0/4, 5/-45/5, 6/270/6, 7/225/7,
        8/180/8, 9/80/9, 10/90/10, 11/80/11, 12/100/12}
      \path (R\n) node[label={[vertex label]\a:$\ell'_{\t}$}] {};
  \end{scope}
\end{tikzpicture}
