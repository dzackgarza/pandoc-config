% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V2.tex
% Type: tikzpicture
% Category: general
% Index: 4

% 0-cusps 1-5 labelled by the symmetry fixing them, 1-cusps labelled by lattice
% and symmetries. The 0-cusp 1 and the 1-cusps incident to it are highlighted.
\begin{tikzpicture}
  \foreach \n/\x/\y/\s/\o in {2/0/0/v/none, 1/6/3/r/dzg highlight,
      3/6/1/d/none, 4/6/-1/h/none, 5/6/-3/$\mathrm{id}$/none}
    \node[cusp0, fill=\o, label=above:{\s}] (\n) at (\x,\y) {\n};
  \foreach \n/\x/\y/\t/\p/\L/\o in {
      12/3/1.5/12/above/{$E_8^2$ r}/dzg highlight,
      245/3/-2/245/below/{$D_{16}*$ h}/none,
      13/10/4.5/13/right/{$E_7^2A_1^2*$ dr}/dzg highlight,
      14/10/3/14/right/{$D_8^2*$ hr}/dzg highlight,
      15/10/1.5/15/right/{$A_{15}A_1(2)*$ dhr}/dzg highlight,
      34/10/0/34/right/{$A_{15}A_1(2)*$ dhr}/none,
      35/10/-1.5/35/right/{$D_{12}D_4*$ d}/none,
      45/10/-3/45/right/{$D_8^2*$ hr}/none,
      55/10/-4.5/5/right/{$E_7^2A_1^2*$ dr}/none}
    \node[cusp1, fill=\o, label={\p:\L}] (\n) at (\x,\y) {\t};
  \foreach \s/\t in {2/12, 1/12, 2/245, 4/245, 5/245, 1/13, 3/13, 1/14, 4/14,
      1/15, 5/15, 3/34, 4/34, 3/35, 5/35, 4/45, 5/45, 5/55}
    \draw[incidence] (\s) -- (\t);
\end{tikzpicture}
