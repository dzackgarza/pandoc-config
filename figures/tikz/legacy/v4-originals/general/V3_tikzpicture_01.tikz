% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V3.tex; also enriques_paper/V2.tex
% Type: tikzpicture
% Category: general
% Index: 1

% E_8 in Bourbaki numbering: alpha_2 hangs below alpha_4.
\begin{tikzpicture}
  \foreach \i/\x in {1/0, 3/1, 4/2, 5/3, 6/4, 7/5, 8/6}
    \node[vertex=black, label=above:$\alpha_{\i}$] (a\i) at (\x,0) {};
  \node[vertex=black, label=right:$\alpha_2$] (a2) at (2,-1) {};
  \begin{scope}[on edge layer]
    \draw[coxeter edge=3] (a1.center) -- (a3.center) -- (a4.center) -- (a5.center)
      -- (a6.center) -- (a7.center) -- (a8.center) (a4.center) -- (a2.center);
  \end{scope}
\end{tikzpicture}
