% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V2.tex
% Type: tikzpicture
% Category: general
% Index: 5

% The symmetries d (diagonal reflection), h (horizontal reflection) and
% r (rotation by pi) of the Vinberg diagram of (18,2,0).
\begin{tikzpicture}[scale=0.9]
  \pic (D) {vinberg 18 2 0};
  \draw[fold axis] (-0.5,-0.5) -- (4.5,4.5);
  \draw[fold] (2,1) -- (1,2);
  \node at (2,-1) {d};
  \begin{scope}[shift={(5,0)}]
    \pic (H) {vinberg 18 2 0};
    \draw[fold axis] (-0.5,2) -- (4.5,2);
    \draw[fold] (1.5,1) -- (1.5,3);
    \node at (2,-1) {h};
  \end{scope}
  \begin{scope}[shift={(10,0)}]
    \pic (R) {vinberg 18 2 0};
    \foreach \a in {5,185}
      \draw[fold, ->] (2,2) ++(\a:1) arc[start angle=\a, delta angle=170, radius=1];
    \node at (2,-1) {r};
  \end{scope}
\end{tikzpicture}
