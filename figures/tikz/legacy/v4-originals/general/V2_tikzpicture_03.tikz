% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V2.tex
% Type: tikzpicture
% Category: general
% Index: 3

\begin{tikzpicture}[scale=0.4]
  \node[cusp0, label={[cusp label]above:$a$}] (a) at (-10,0) {$U\oplus E_8^2$};
  \node[cusp1] (a1) at (-4,3) {$E_8^{2}$};
  \node[cusp1] (a2) at (-4,-3) {$D_{16}*$};
  \node[cusp0, label={[cusp label]above:$b$}] (b) at (2,0) {$U(2) \oplus E_8^2$};
  \foreach \i/\y/\L in {1/5/D_8^2*, 2/3/E_7^{2} A_1^{2}*, 3/1/E_8 D_8,
      4/-1/D_{12} D_4*, 5/-3/D_{16}, 6/-5/A_{15} A_1(2)*}
    \node[cusp1, anchor=west] (b\i) at (11,\y) {$\L$};
  \foreach \x/\L in {-10/{(18, 0, 0)_1}, -4/{(16, 0, 0)_0}, 2/{(18, 2, 0)_1}}
    \node[cusp label] at (\x,-6) {$\L$};
  \node[anchor=south] at (4,4.5) {$\overline{F_{4, h.e.}} {}^{bb}$};
  \draw[decorate, decoration={brace, amplitude=15pt}] (16,6)
    -- (16,-6) node[midway, right=2em, cusp label] {$(16, 2, 0)_0$};
  \draw[incidence] (a) -- (a1.west);
  \draw[incidence] (a) -- (a2.west);
  \draw[incidence] (b) -- (a1.east);
  \draw[incidence] (b) -- (a2.east);
  \foreach \i in {1,...,6} \draw[incidence] (b) -- (b\i.west);
\end{tikzpicture}
