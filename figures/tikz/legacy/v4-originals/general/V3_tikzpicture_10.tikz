% The diagonal reflection d of the Vinberg diagram of (18,2,0) and the labels
% of its roots after identifying each d-orbit.
\begin{tikzpicture}
  \pic (L) [root labels=ell] {vinberg 18 2 0};
  \draw[fold axis, opacity=0.5] (-0.8,-0.8) -- (4.8,4.8);
  \draw[fold, opacity=0.2] (1,2) -- (2,1);
  \begin{scope}[shift={(7,0)}]
    \pic (R) {vinberg 18 2 0};
    \foreach \n/\a/\t in {1/135/5, 2/90/6, 3/90/7, 4/90/8, 5/45/9, 6/0/8, 7/0/7, 8/0/6,
        9/-45/5, 10/270/4, 11/270/3, 12/270/2, 13/225/1, 14/180/2,
        15/180/3, 16/180/4, 17/80/10, 18/90/11, 19/80/10, 20/100/12}
      \path (R\n) node[label={[vertex label]\a:$\ell'_{\t}$}] {};
    \draw[fold axis, opacity=0.5] (-0.8,-0.8) -- (4.8,4.8);
    \draw[fold, opacity=0.2] (1,2) -- (2,1);
  \end{scope}
\end{tikzpicture}
