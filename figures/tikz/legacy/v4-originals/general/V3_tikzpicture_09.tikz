% The symmetry v of the Vinberg diagram of (18,0,0) and the labels of its
% roots after identifying each v-orbit.
\begin{tikzpicture}[x={(1,0)}, y={(60:1)}]
  \pic (L) [root labels=ell] {vinberg 18 0 0};
  \draw[fold axis, opacity=0.5] (3.5,-1) -- (-0.5,7);
  \draw[fold, opacity=0.3] (1.25,2) -- (2.75,2);
  \begin{scope}[shift={(7,0)}]
    \pic (R) {vinberg 18 0 0};
    \foreach \n/\a/\t in {1/270/1, 2/270/2, 3/270/3, 4/170/4, 5/170/5, 6/170/6,
        7/170/7, 8/170/8, 9/100/8, 10/10/8, 11/10/7, 12/10/6,
        13/10/5, 14/10/4, 15/270/3, 16/270/2, 17/270/1, 18/10/10,
        19/170/10}
      \path (R\n) node[label={[vertex label]\a:$\ell'_{\t}$}] {};
    \draw[fold axis, opacity=0.5] (3.5,-1) -- (-0.5,7);
    \draw[fold, opacity=0.3] (1.25,2) -- (2.75,2);
  \end{scope}
\end{tikzpicture}
