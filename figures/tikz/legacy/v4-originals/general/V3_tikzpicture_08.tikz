% TikZ Diagram from V4 Thesis
% Source: writing/sources/enriques_paper/V3.tex
% Type: tikzpicture
% Category: general
% Index: 8

% The rotation r of the Vinberg diagram of (18,2,0) and the labels of its
% roots after identifying each r-orbit.
\begin{tikzpicture}
  \pic (L) [root labels=ell] {vinberg 18 2 0};
  \foreach \a in {5,185}
    \draw[fold, ->, opacity=0.2] (2,2) ++(\a:1)
      arc[start angle=\a, delta angle=170, radius=1];
  \begin{scope}[shift={(7,0)}]
    \pic (R) {vinberg 18 2 0};
    \foreach \n/\a/\t in {1/135/1, 2/90/2, 3/90/3, 4/90/4, 5/45/5, 6/0/6, 7/0/7, 8/0/7,
        9/-45/1, 10/270/2, 11/270/3, 12/270/4, 13/225/5, 14/180/6,
        15/180/7, 16/180/8, 17/80/9, 18/90/10, 19/80/9, 20/100/10}
      \path (R\n) node[label={[vertex label]\a:$\ell'_{\t}$}] {};
    \foreach \a in {5,185}
      \draw[fold, ->, opacity=0.2] (2,2) ++(\a:1)
        arc[start angle=\a, delta angle=170, radius=1];
  \end{scope}
\end{tikzpicture}
