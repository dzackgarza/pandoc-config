\begin{tikzpicture}[>=Latex, line cap=round, line join=round, scale=0.9]
  \fill[blue!5] (-4.5,-0.2) .. controls (-4,2.6) and (2.8,3.1) .. (4.3,1.4)
    .. controls (4.7,0.2) and (4.2,-1.0) .. (3.3,-1.5)
    .. controls (0.5,-2.2) and (-3.4,-1.7) .. cycle;
  \draw[thick] (-4.5,-0.2) .. controls (-4,2.6) and (2.8,3.1) .. (4.3,1.4)
    .. controls (4.7,0.2) and (4.2,-1.0) .. (3.3,-1.5)
    .. controls (0.5,-2.2) and (-3.4,-1.7) .. cycle;
  \draw[very thick, red!70!black] (3.95,-1.25) -- (4.3,1.4);
  \node[red!70!black, right] at (4.15,0.5) {$\partial\mathcal M$};
  \node at (-2.9,1.95) {$\mathcal M$};

  \draw[very thick, ->] (-3.4,0.85) .. controls (-1.4,1.55) and (1.4,0.3) .. (4.05,0.55);
  \node[above] at (-0.3,1.05) {$C$};
  \coordinate (p0) at (-2.7,1.05);
  \coordinate (pt) at (0.25,0.82);
  \coordinate (pinf) at (4.02,0.55);
  \fill (p0) circle (2pt) node[above left] {$0$};
  \fill (pt) circle (2pt) node[above] {$t$};
  \fill[red!70!black] (pinf) circle (2.2pt) node[above right] {$\infty$};

  \foreach \x/\lab in {-2.7/{\mathcal X_0},0.25/{\mathcal X_t}} {
    \draw[->] (\x,0.7) -- (\x,-0.25);
    \draw[thick, fill=yellow!12] (\x-0.8,-1.25)
      .. controls (\x-0.45,-0.55) and (\x+0.45,-0.55) .. (\x+0.8,-1.25)
      .. controls (\x+0.4,-1.85) and (\x-0.45,-1.85) .. cycle;
    \draw[thin] (\x-0.55,-1.25) .. controls (\x,-0.95) and (\x+0.35,-1.55) .. (\x+0.6,-1.3);
    \node[below] at (\x,-1.9) {$\lab$};
  }

  \draw[->, red!70!black] (4.02,0.38) -- (3.15,-0.35);
  \draw[thick, fill=red!8] (2.3,-1.25)
    .. controls (2.75,-0.55) and (3.55,-0.55) .. (3.95,-1.25)
    .. controls (3.55,-1.85) and (2.75,-1.85) .. cycle;
  \draw[thick] (2.62,-1.63) -- (3.63,-0.83);
  \draw[thick] (2.62,-0.83) -- (3.63,-1.63);
  \node[below] at (3.12,-1.9) {$\mathcal X_\infty$};
\end{tikzpicture}
