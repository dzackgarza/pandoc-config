% A one-parameter degeneration: a curve C in the moduli space M runs from 0
% through t to a point at infinity on the boundary, and the fibres X_0, X_t
% degenerate to the singular fibre X_infinity.
\begin{tikzpicture}[scale=0.9]
  \coordinate (bdtop) at (4.3,1.4);
  \coordinate (bdbot) at (3.95,-1.25);
  \draw[moduli blob] (-4.5,-0.2) to[closed, curve through={
    (-0.5,2.3) (bdtop) (bdbot) (-1.2,-1.7)}] (-4.5,-0.2);
  \draw[boundary stratum] (bdbot) -- (bdtop)
    node[pos=0.95, right, text=dzg singular] {$\partial\mathcal M$};
  \node at (-3.9,1.6) {$\mathcal M$};

  \coordinate (p0) at (-2.7,1.05);
  \coordinate (pt) at (0.25,0.82);
  \coordinate (pinf) at ($(bdbot)!0.68!(bdtop)$);
  \draw[degeneration] (-3.4,0.85)
    to[curve through={(p0) (pt)}] (pinf);
  \node[above] at (-0.3,1.05) {$C$};
  \node[stratum, label=above left:$0$] at (p0) {};
  \node[stratum, label=above:$t$] at (pt) {};
  \node[stratum, fill=dzg singular, label={[text=dzg singular]right:$\infty$}]
    at (pinf) {};

  % Fibres: a smooth surface over 0 and t, two crossing components over infinity.
  \foreach \x/\fibre/\tint in {-2.7/{\mathcal X_0}/dzg region,
                               0.25/{\mathcal X_t}/dzg region,
                               3.12/{\mathcal X_\infty}/dzg singular!15} {
    \draw[curve component, fill=\tint] (\x-0.8,-1.25) to[bend left=60] (\x+0.8,-1.25)
      to[bend left=60] (\x-0.8,-1.25) -- cycle;
    \node[below] at (\x,-1.9) {$\fibre$};
  }
  \foreach \x in {-2.7, 0.25} {
    \draw[->] (\x,0.7) -- (\x,-0.25);
    \draw (\x-0.55,-1.25) to[curve through={(\x-0.06,-1.19) (\x+0.31,-1.33)}]
      (\x+0.6,-1.3);
  }
  \draw[curve component] (2.62,-1.63) -- (3.63,-0.83) (2.62,-0.83) -- (3.63,-1.63);
  \draw[->, dzg singular] ([yshift=-5pt]pinf) -- (3.15,-0.35);
\end{tikzpicture}
