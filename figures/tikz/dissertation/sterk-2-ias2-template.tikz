\begin{tikzpicture}
  % Template for the IAS^2 of Sterk 2: lattice vertices, the singular points
  % with their multiplicities, and the dashed outer triangulation.
  \foreach \name/\x/\y in {a/-1/1, b/1/1, c/-1/-1, d/1/-1, e/-1/3, f/1/3,
      g/-3/3, h/-3/1, i/-3/-1, j/3/1, k/3/-1, l/-1/-3, m/1/-3, n/3/-3,
      o/1/7, p/7/1, q/-7/-1, r/-1/-7}
    \coordinate (\name) at (\x, \y);

  \draw[ias edge] (b) -- (a) -- (c) -- (d) -- (b)  (h) -- (a) -- (e) -- (b)
    (h) -- (c)  (b) -- (k)  (c) -- (m);
  \draw[ias edge, dashed] (b) -- (f) -- (e) -- (g) -- (h) -- (i) -- (c)
    (b) -- (j) -- (k) -- (n) -- (m) -- (l) -- (c)  (d) -- (m)  (d) -- (k)
    (p) -- (b) -- (o) -- (p)  (g) -- (o)  (g) -- (q) -- (i)  (q) -- (r) -- (c)
    (p) -- (r);
  \draw[ias edge, draw=dzg accent] (g) -- (a)  (d) -- (n);
  \draw[ias edge, draw=dzg accent, dashed] (a) -- (d);
  \draw[ias edge, draw=dzg singular, dashed] (-4, -4) -- (4, 4);

  \foreach \p/\m in {b/2, c/2, j/2, l/2, n/16}
    \node[ias singularity=\m] at (\p) {};
\end{tikzpicture}
