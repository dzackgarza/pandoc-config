\begin{tikzpicture}
  % Baily-Borel boundary of F_{(2,2,0)}.
  \matrix [matrix of math nodes, row sep={1cm,between origins}, column sep=1cm] {
    & & & |[cusp1, label={[cusp label]above:\mathrm{div} = (1, ?)}] (C1)| D_8^2* \\
    & |[cusp1, label={[cusp label]above:\mathrm{div} = (2, 1)}] (Ca)| E_8^2 & &
      |[cusp1] (C2)| E_7^2C_2* \\
    & & & |[cusp1] (C3)| E_8D_8 \\
    |[cusp0, label={[cusp label]above:\mathrm{div} = 2}] (v0)| U \oplus E_8^2 & &
      |[cusp0, label={[cusp label]above:\mathrm{div} = 1}] (v1)| U(2) \oplus E_8^2 & \\
    & |[cusp1] (Cb)| D_{16}* & & |[cusp1] (C4)| D_{12}D_4* \\
    & & & |[cusp1] (C5)| D_{16} \\
    & & & |[cusp1] (C6)| (A_{15}A_1(2))* \\
  };
  \foreach \p/\c in {v0/Ca, v0/Cb, v1/Ca, v1/Cb, v1/C1, v1/C2, v1/C3, v1/C4,
      v1/C5, v1/C6}
    \draw[incidence] (\p) -- (\c);

  \foreach \n/\invariants in {v0/{(18,0,0)_1}, Cb/{(16,0,0)_0}, v1/{(18,2,0)_1},
      C6/{(16,2,0)_0}}
    \draw[cusp brace] (\n.west |- C6) -- (\n.east |- C6)
      node[midway, below=5.5ex] {$\invariants$};
\end{tikzpicture}
