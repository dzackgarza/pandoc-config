\begin{tikzpicture}[scale=2]
  % The dual complex of a Type III degeneration: vertices H_i, edges L_ij
  % (double curves), faces P_ijk (triple points).
  \coordinate (H1) at (0, 0);
  \coordinate (H2) at (4, 0);
  \coordinate (H3) at (3, 2);
  \coordinate (H4) at (2, 3);

  \begin{scope}[ias boundary, draw=dzg accent, text=dzg accent]
    \draw (H1) -- node[pos=0.25, below] {$L_{12}$} (H2);
    \draw[dashed] (H1) -- node[pos=0.5, above] {$L_{13}$} (H3);
    \draw (H1) -- node[pos=0.5, above left] {$L_{14}$} (H4);
    \draw (H2) -- node[pos=0.5, right] {$L_{23}$} (H3);
    \draw (H3) -- node[pos=0.5, above right] {$L_{34}$} (H4);
    \draw (H2) -- node[pos=0.5, below left] {$L_{24}$} (H4);
  \end{scope}

  \node[stratum, label=below left:{$H_1$}] at (H1) {};
  \node[stratum, label=below right:{$H_2$}] at (H2) {};
  \node[stratum, label=above right:{$H_3$}] at (H3) {};
  \node[stratum, label=above:{$H_4$}] at (H4) {};

  % Faces, and arrows from their labels into them.
  \begin{scope}[text=dzg singular]
    \node (P124) at (0.1, 1) {$P_{124}$};
    \node (P234) at (3.6, 2.2) {$P_{234}$};
    \node (P134) at (1, 2.6) {$P_{134}$};
    \node (P123) at (3, -0.25) {$P_{123}$};
  \end{scope}
  \draw[->, dzg singular, bend right=10] (P124) to (2, 1);
  \draw[->, dzg singular, bend right=30] (P234) to (2.7, 2.1);

  \begin{scope}[on background layer]
    \draw[->, dzg singular, bend left=30, dashed] (P134) to (2, 2.1);
    \draw[->, dzg singular, bend left=30, dashed] (P123) to (2.5, 0.25);
    \fill[dzg singular!10, opacity=0.8] (H2) -- (H3) -- (H4) -- cycle;
    \fill[pattern=north east lines, pattern color=dzg singular!30, opacity=0.3]
      (H1) -- (H3) -- (H4) -- cycle;
    \fill[pattern=vertical lines, pattern color=dzg singular, opacity=0.45]
      (H2) -- (H3) -- (H4) -- cycle;
    \fill[dzg singular, opacity=0.15] (H1) -- (H2) -- (H3) -- cycle;
    \fill[dzg singular!40, opacity=0.1] (H1) -- (H3) -- (H4) -- cycle;
  \end{scope}
\end{tikzpicture}
