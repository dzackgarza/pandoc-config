\begin{tikzpicture}
\begin{pgfonlayer}{nodelayer}
    \node[style=white node, label={below left:$r_{0}$}] (r0) at (0,0) {};
    \node[style=white node, label={below:$r_{1}$}] (r1) at (1,0) {};
    \node[style=white node, label={below:$r_{2}$}] (r2) at (2,0) {};
    \node[style=white node, label={below:$r_{3}$}] (r3) at (3,0) {};
    \node[style=white node, label={below right:$r_{4}$}] (r4) at (4,0) {};
    \node[style=white node, label={right:$r_{5}$}] (r5) at (4,1) {};
    \node[style=white node, label={right:$r_{6}$}] (r6) at (4,2) {};
    \node[style=white node, label={right:$r_{7}$}] (r7) at (4,3) {};
    \node[style=white node, label={above right:$r_{8}$}] (r8) at (4,4) {};
    \node[style=white node, label={above:$r_{9}$}] (r9) at (3,4) {};
    \node[style=white node, label={above:$r_{10}$}] (r10) at (2,4) {};
    \node[style=white node, label={above:$r_{11}$}] (r11) at (1,4) {};
    \node[style=white node, label={above left:$r_{12}$}] (r12) at (0,4) {};
    \node[style=white node, label={left:$r_{13}$}] (r13) at (0,3) {};
    \node[style=white node, label={left:$r_{14}$}] (r14) at (0,2) {};
    \node[style=white node, label={left:$r_{15}$}] (r15) at (0,1) {};

    \node[style=white node, label={above left:$r_{16}$}] (r16) at (1,1) {};
    \node[style=white node, label={below:$r_{18}$}] (r18) at (3,3) {};
    \node[style=white node, label={below left:$r_{19}$}] (r19) at (1,3) {};
    \node[style=white node, label={above:$r_{17}$}] (r17) at (3,1) {};

    \node[style=black node, label={above:$r_{20}$}] (r20) at (2,2.5) {};
    \node[style=black node, label={below:$r_{21}$}] (r21) at (2,1.5) {};
		\end{pgfonlayer}
\begin{pgfonlayer}{edgelayer}
\foreach \i in {0,...,14} {
	\pgfmathsetmacro\ip{int(\i+1 )}
	\draw[style=plain edge] (r\i) to (r\ip);
}
\draw[style=plain edge] (r15) to (r0);

\draw[style=plain edge] (r0) to (r16);
\draw[style=plain edge] (r4) to (r17);
\draw[style=plain edge] (r8) to (r18);
\draw[style=plain edge] (r12) to (r19);

\draw[style=double edge] (r16) -- (r20) -- (r18);
\draw[style=double edge] (r19) -- (r21) -- (r17);
\draw[style=thick edge] (r20) to (r21);
\end{pgfonlayer}
\end{tikzpicture}