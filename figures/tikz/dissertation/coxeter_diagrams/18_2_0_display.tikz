\begin{tikzpicture}
\foreach \n/\m/\p/\a in {0/white/{0,0}/below left, 1/white/{1,0}/below, 2/white/{2,0}/below,
    3/white/{3,0}/below, 4/white/{4,0}/below right, 5/white/{4,1}/right,
    6/white/{4,2}/right, 7/white/{4,3}/right, 8/white/{4,4}/above right,
    9/white/{3,4}/above, 10/white/{2,4}/above, 11/white/{1,4}/above,
    12/white/{0,4}/above left, 13/white/{0,3}/left, 14/white/{0,2}/left,
    15/white/{0,1}/left, 16/white/{1,1}/above left, 17/white/{3,1}/above,
    18/white/{3,3}/below, 19/white/{1,3}/below left,
    20/black/{2,2.5}/above, 21/black/{2,1.5}/below}
  \node[vertex=\m, label={[vertex label]\a:$r_{\n}$}] (r\n) at (\p) {};
\begin{scope}[on edge layer]
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {0,...,14}
    \draw[coxeter edge=3] (r\i) -- (r\j);
  \draw[coxeter edge=3] (r15) -- (r0) (r0) -- (r16) (r4) -- (r17) (r8) -- (r18) (r12) -- (r19);
  \draw[coxeter edge=4] (r16) -- (r20) -- (r18) (r19) -- (r21) -- (r17);
  \draw[coxeter edge=infinity] (r20) -- (r21);
\end{scope}
\end{tikzpicture}
