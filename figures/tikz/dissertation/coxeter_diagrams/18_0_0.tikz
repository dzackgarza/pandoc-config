\begin{scope}[y={(60:1)}]
\foreach \n/\p/\a in {1/{2,0}/below, 2/{1,0}/below, 3/{0,0}/below, 4/{0,1}/left,
    5/{0,2}/left, 6/{0,3}/left, 7/{0,4}/left, 8/{0,5}/left, 9/{0,6}/above,
    10/{1,5}/right, 11/{2,4}/right, 12/{3,3}/right, 13/{4,2}/right, 14/{5,1}/right,
    15/{6,0}/below, 16/{5,0}/below, 17/{4,0}/below, 18/{1,1}/right, 19/{4,1}/left}
  \node[vertex=white, label={[vertex label]\a:$r_{\n}$}] (r\n) at (\p) {};
\begin{scope}[on edge layer]
  \foreach \i [evaluate=\i as \j using int(\i+1)] in {1,...,16}
    \draw[coxeter edge=3] (r\i) -- (r\j);
  \draw[coxeter edge=3] (r3) -- (r18) (r15) -- (r19);
\end{scope}
\end{scope}
