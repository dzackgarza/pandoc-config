\begin{tikzpicture}[node distance=2.4cm]
  \node[cusp0, label={[cusp label]left:$\bD^2$},
    label={[cusp label]above:$\mathrm{div}\gens{e'} = 2$}] (v0) {$\gens{2} \oplus E_{8}(2)$};
  \node[cusp1, right=of v0,
    label={[cusp label]above:$\mathrm{div}\gens{e', 2h+\alpha_1+\alpha_2} = (2, 2)$}]
    (C0) {$A_1^{\oplus 7}$};
  \draw[incidence] (v0) -- (C0);

  \draw[cusp brace] (v0.west) -- (v0.east) node[midway, below=5.5ex] {$(9,9,1)_1$};
  \draw[cusp brace] (C0.west) -- (C0.east) node[midway, below=5.5ex] {$(7,7,1)_0$};
\end{tikzpicture}
