\newcommand{\ADEAn}[1]{%

\pgfmathsetmacro{\n}{#1}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\npone}{int(\n+1)}


\node (A) at (0,0) {};
\node (Ap) at (0,1) {};
\node (B) at (0, 2) {};
\node (C) at (\npone, 0) {};

\begin{pgfonlayer}{nodelayer}
\node[ADE blue node, label={below:$1$}] at (A) {};
\node[ADE blue node, label={left:$y$}] at (Ap) {};
\node[ADE blue node, label={below:$x^{\npone}$}] at (C) {};
\node[ADE blue node, label={left:$y^2$}] at (B) {};

\ifthenelse{\not\isodd{\npone}}{
	\pgfmathsetmacro{\halfn}{int(\n/2)}
	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($(B)!1/2!(C)$) {};
}{}


\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,2,...,\n}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\foreach \i [evaluate=\i as \j using \i+1] in {1,2,...,\dmax} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (A) grid (\npone,2);
\draw[blue, very thick] (A.center) -- (B.center) -- (C.center);
\fill[blue!50, opacity=0.2] (A.center) -- (B.center) -- (C.center) -- cycle;
\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p1.center) to (p\n.center);
\end{scope}
\end{pgfonlayer}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ADEmAnm}[1]{%

\pgfmathsetmacro{\n}{#1}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\npone}{int(\n+1)}
\pgfmathsetmacro{\nptwo}{int(\n+2)}


\node (A) at (1,0) {};
\node (Ap) at (0,1) {};
\node (B) at (0, 2) {};
\node (C) at (\nptwo, 0) {};

\begin{pgfonlayer}{nodelayer}
\node[label={below:$1$}] at (0, 0) {};
\node[label={left:$y$}] at (0,1) {};
\node[ADE blue node, label={below:$x^1$}] at (1,0) {};
\node[ADE blue node, label={below:$x^{\nptwo}$}] at (C) {};
\node[ADE blue node, label={left:$y^2$}] at (B) {};

\ifthenelse{\not\isodd{\nptwo}}{
	\pgfmathsetmacro{\halfn}{int(\nptwo/2)}
	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($(B)!1/2!(C)$) {};
}{}


\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {2,...,\npone}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\foreach \i [evaluate=\i as \j using \i+1] in {2,...,\n} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0, 0) grid (\nptwo,2);
\draw[blue, very thick] (A.center) -- (B.center) -- (C.center);
\fill[blue!50, opacity=0.2] (A.center) -- (B.center) -- (C.center) -- cycle;
\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p2.center) to (p\npone.center);
\end{scope}
\end{pgfonlayer}
}

\newcommand{\ADEDn}[1]{%

\pgfmathsetmacro{\m}{#1}
\pgfmathsetmacro{\n}{int(\m-3)}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\npone}{int(\n+1)}


\node[label={below:$1$}] (A) at (0,0) {};
\node[label={left:$y$}] (Ap) at (0,1) {};
\node (B) at (0, 2) {};
\node (C) at (\npone, 0) {};
\node (D) at (\npone, 2) {};

\begin{pgfonlayer}{nodelayer}
%\node[ADE blue node, label={below:$1$}] at (A) {};
%\node[ADE blue node, label={left:$y$}] at (Ap) {};
\node[ADE blue node, label={below:$x^{\npone}$}] at (C) {};
\node[ADE blue node, label={above:$y^2$}] at (B) {};

\node[ADE blue node, label={above:$xy^2$}] at (1,2) {};

\node[ADE blue node, label={above:$x^2y^2$}] at (2,2) {};

\ifthenelse{\not\isodd{\npone}}{
	\pgfmathsetmacro{\halfn}{int(\n/2 + 2)}
	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($(2,2)!1/2!(C)$) {};
}{}


\node[style=ADE black node] (q00) at (0,0) {};
\node[style=ADE white node] (q10) at (1,0) {};
\node[style=ADE white node] (q01) at (0,1) {};
\node[style=ADE white node, label={right:$xy$}] (q11) at (1,1) {};

\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,2,...,\n}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\draw[ADE plain edge] (q01) -- (q00) -- (q11);
\draw[ADE plain edge] (q00) -- (q10);
\foreach \i [evaluate=\i as \j using \i+1] in {1,...,\dmax} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0,0) grid (\npone,2);
\draw[blue, very thick] (B.center) -- (2,2) -- (C.center);
\fill[blue!50, opacity=0.2]  (B.center) -- (2,2) -- (C.center) -- (A.center);
\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (q01.center) to (q00.center) to (q11.center);
\draw[hlt] (q00.center) to (p\n.center);
\end{scope}
\end{pgfonlayer}
}

\newcommand{\ADEDntilde}[1]{%

\pgfmathsetmacro{\m}{#1}
\pgfmathsetmacro{\n}{int(\m-3)}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\npone}{int(\n+1)}


\node[label={below:$1$}] (A) at (0,0) {};
\node[label={left:$y$}] (Ap) at (0,1) {};
\node (B) at (0, 2) {};
\node (C) at (\npone, 0) {};
\node (D) at (\npone, 2) {};

\begin{pgfonlayer}{nodelayer}
%\node[ADE blue node, label={below:$1$}] at (A) {};
%\node[ADE blue node, label={left:$y$}] at (Ap) {};

\node[ADE blue node] at (\npone, 2) {};
\node[ADE blue node, label={above:$y^2$}] at (B) {};





\node[style=ADE black node] (q00) at (0,0) {};
\node[style=ADE white node] (q10) at (1,0) {};
\node[style=ADE white node] (q01) at (0,1) {};
\node[style=ADE white node, label={right:$xy$}] (q11) at (1,1) {};

\node[style=ADE black node, label={below:$x^{\npone}$}] (r00) at (\npone,0) {};
\node[style=ADE white node, label={right:$x^{\npone}y$}] (r01) at (\npone,1) {};\node[style=ADE white node, label={left:$x^{\n}y$}] (r11) at (\npone-1,1) {};

\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,2,...,\n}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
	\node[ADE blue node, label={above:$x^{\i}y^2$}] at (\i,2) {};

}
	\node[ADE blue node, label={above:$x^{\npone}y^2$}] at (\npone,2) {};

\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\draw[ADE plain edge] (q01) -- (q00) -- (q11);
\draw[ADE plain edge] (q00) -- (q10);
\draw[ADE plain edge] (r01) -- (r00) -- (r11);
\draw[ADE plain edge] (r00) -- (p\n);
\foreach \i [evaluate=\i as \j using \i+1] in {1,...,\dmax} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0,0) grid (\npone,2);
\draw[blue, very thick] (0,2) -- (\npone,2);
\fill[blue!50, opacity=0.2]  (0,0) -- (0,2) -- (\npone,2) -- (\npone, 0) -- cycle;
\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (q01.center) to (q00.center) to (q11.center);
\draw[hlt] (q00.center) to (r00.center);
\draw[hlt] (r00.center) to (r01.center);
\draw[hlt] (r00.center) to (r11.center);

\end{scope}
\end{pgfonlayer}
}

\newcommand{\ADEPrimeAn}[1]{%

\pgfmathsetmacro{\n}{#1}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\dmaxtt}{int(\n-3)}
\pgfmathsetmacro{\dmaxttt}{int(\n-4)}
\pgfmathsetmacro{\dmaxtttt}{int(\n-5)}

\pgfmathsetmacro{\npone}{int(\n+1)}


\begin{pgfonlayer}{nodelayer}
\node[label={below:$1$}] at (0,0) {};
\node[ADE blue node, label={left:$y$}] at (0,1) {};
\node[ADE blue node, label={below:$x^{\dmax}$}] at (\dmax,0) {};
\node[label={left:$y^2$}] at (0,2) {};
\node[ADE blue node, label={above:$x^2y$}] at (2,2) {};

\ifthenelse{\not\isodd{\dmax}}{
	\pgfmathsetmacro{\halfn}{int(\n/2+1)}
	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($((0,2)!1/2!(\dmax, 0) + (1,0)$) {};
}{}


\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,...,\dmaxt}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\node[style=ADE black node] (p0) at (0,0) {};
\node[style=ADE white node, label={right:$xy$}] (pn1) at (1,1) {};
\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\draw[ADE plain edge] (pn1) to (p0);
\foreach \i [evaluate=\i as \j using \i+1] in {0,...,\dmaxtt} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0,0) grid (\dmax,2);
\draw[blue, very thick] (0, 1) -- (2,2) -- (\dmax, 0);
\fill[blue!50, opacity=0.2] (0,0) -- (0,1) -- (2,2) -- (\dmax,0) -- cycle;
\draw[black, very thick, opacity=0.3] (0,1) to (0,0) to (\dmax,0);

\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p0.center) to (p\dmaxt.center);
\draw[hlt] (pn1.center) to (p0.center);
\end{scope}
\end{pgfonlayer}
}

\newcommand{\ADEPrimePrimeAn}[1]{%

\pgfmathsetmacro{\n}{#1}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\dmaxtt}{int(\n-3)}
\pgfmathsetmacro{\dmaxttt}{int(\n-4)}
\pgfmathsetmacro{\dmaxtttt}{int(\n-5)}

\pgfmathsetmacro{\npone}{int(\n+1)}


\begin{pgfonlayer}{nodelayer}
\node[label={below:$1$}] at (0,0) {};
\node[ADE blue node, label={left:$y$}] at (0,1) {};
\node[ADE blue node, label={right:$x^{\dmaxtt}y$}] at (\dmaxtt,1) {};

\node[label={left:$y^2$}] at (0,2) {};
\node[ADE blue node, label={above:$x^2y^2$}] at (2,2) {};

% \ifthenelse{\not\isodd{\dmaxt}}{
% 	\pgfmathsetmacro{\halfn}{int(\n/2+1)}
% 	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($((0,2)!1/2!(\dmax, 0) + (1,0)$) {};
% }{}


\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,...,\dmaxtt}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\node[style=ADE black node] (p0) at (0,0) {};
\node[style=ADE white node, label={left:$xy$}] (pn1) at (1,1) {};
\node[ADE white node, label={left:$x^{\dmaxttt}y$}] (pm1) at (\dmax-3,1) {};

\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\draw[ADE plain edge] (pn1) to (p0);
\draw[ADE plain edge] (pm1) to (p\dmaxtt);
\foreach \i [evaluate=\i as \j using \i+1] in {0,...,\dmaxttt} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0,0) grid (\dmaxtt,2);
\draw[blue, very thick] (0, 1) -- (2,2) -- (\dmaxtt, 1);
\fill[blue!50, opacity=0.2] (0,0) -- (0,1) -- (2,2) -- (\dmaxtt,1) -- (\dmaxtt,0) -- cycle;
\draw[black, very thick, opacity=0.3] (0,1) to (0,0) to (\dmaxtt,0);

\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p0.center) to (p\dmaxtt.center);
\draw[hlt] (pn1.center) to (p0.center);
\draw[hlt] (pm1.center) to (p\dmaxtt.center);
\end{scope}
\node at (\dmaxtt-0.25, 3) {\Huge $'A_{\n}'$};
\end{pgfonlayer}
}

\newcommand{\ADEPrimeDn}[1]{%

\pgfmathsetmacro{\n}{#1}
\pgfmathsetmacro{\dmax}{int(\n-1)}
\pgfmathsetmacro{\dmaxt}{int(\n-2)}
\pgfmathsetmacro{\dmaxtt}{int(\n-3)}
\pgfmathsetmacro{\dmaxttt}{int(\n-4)}
\pgfmathsetmacro{\dmaxtttt}{int(\n-5)}

\pgfmathsetmacro{\npone}{int(\n+1)}


\begin{pgfonlayer}{nodelayer}
\node[label={below:$1$}] at (0,0) {};
\node[ label={left:$y$}] at (0,1) {};
\node[ADE blue node, label={right:$x^{\dmaxttt}y$}] at (\dmaxttt,1) {};

\node[ADE blue node, label={left:$y^2$}] at (0,2) {};
\node[ADE blue node, label={above:$x^2y^2$}] at (2,2) {};
\node[ADE blue node, label={above:$xy^2$}] at (1,2) {};
% \ifthenelse{\not\isodd{\dmaxt}}{
% 	\pgfmathsetmacro{\halfn}{int(\n/2+1)}
% 	\node[ADE blue node, label={above right:$x^{\halfn}y$}] at ($((0,2)!1/2!(\dmax, 0) + (1,0)$) {};
% }{}


\foreach[evaluate=\i as \zm using {iseven(\i)?"ADE black node":"ADE white node"}] \i in {1,...,\dmaxttt}
{
	\node[style=\zm, label={below:$x^{\i}$}] (p\i) at (\i, 0) {};
}
\node[style=ADE white node] (p01) at (0,1) {};
\node[style=ADE black node] (p0) at (0,0) {};
\node[style=ADE white node, label={left:$xy$}] (pn1) at (1,1) {};
\node[ADE white node, label={left:$x^{\dmaxtttt}y$}] (pm1) at (\dmaxtttt,1) {};

\end{pgfonlayer}

\begin{pgfonlayer}{edgelayer}
\draw[ADE plain edge] (pn1) to (p0);
\draw[ADE plain edge] (p0) to (p01);
\draw[ADE plain edge] (pm1) to (p\dmaxttt);
\foreach \i [evaluate=\i as \j using \i+1] in {0,...,\dmaxtttt} 
{
\draw[ADE plain edge] (p\i) to (p\j);
}
\end{pgfonlayer}

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0,0) grid (\dmaxttt,2);
\draw[blue, very thick] (0, 2) -- (2,2) -- (\dmaxttt, 1);
\fill[blue!50, opacity=0.2] (0,0) -- (0,2) -- (2,2) -- (\dmaxttt,1) -- (\dmaxttt,0) -- cycle;
\draw[black, very thick, opacity=0.3] (0,2) to (0,0) to (\dmaxttt,0) -- (\dmaxttt, 1);

\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p0.center) to (p\dmaxttt.center);
\draw[hlt] (pn1.center) to (p0.center);
\draw[hlt] (pm1.center) to (p\dmaxttt.center);
\draw[hlt] (p0.center) to (p01.center);

\end{scope}
\node at (\dmaxttt-0.25, 2.5) {\Large $D_{\n}'$};
\end{pgfonlayer}
}
