
\input{ADE_macros.tikz}

\begin{tikzpicture}
\pgfmathsetmacro{\total}{0}
\foreach \l in {5,...,8}
{
\begin{scope}[shift={(\total, 0)}]
\ADEDn{\l}
\ifthenelse{\not\isodd{\l}}{
\node at (\npone-0.5, 3) {\Large $D_\l$};
\draw[BB cusp brace, color=blue] (\n+0.75,0.5) to node[midway, yshift=2.5em,xshift=1.5em] {$2$} (2.2, 2);
\draw[BB cusp brace, color=blue] (2,2.25) to node[midway,yshift=3em, xshift=0em] {$2$} (0, 2.25);

}{
\node at (\npone-0.5, 3) {\Large $D_\l^{-}$};
\draw[BB cusp brace, color=blue] ($(\l-2, 0)$) to  ($(2, 2)$);
\node[blue] at ($(\l-1, 0)!1/2!(2,3) +(0.2,0.5)$) {$1$};
\draw[BB cusp brace, color=blue] (2,2.25) to node[midway,yshift=3em, xshift=0em] {$2$} (0, 2.25);
}

\begin{pgfonlayer}{background}
\draw[black, very thick, opacity=0.3] (0,2) to (0,0) to (\n+1,0);
\end{pgfonlayer}

\end{scope}
\pgfmathtruncatemacro{\newtotal}{\total + \l-1}
  \xdef\total{\newtotal} % make the new total globally available
}


\end{tikzpicture}