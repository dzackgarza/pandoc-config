\begin{tikzpicture}
\foreach \m [remember=\xnext as \xoff (initially 0),
    evaluate=\m as \xnext using \xoff+\m+1] in {5,...,8} {
  \begin{scope}[shift={(\xoff,0)}]
    \ADEDn{\m}
    \node[polygon title, below=7mm of lp.south]
      {\ifodd\m $D_{\m}^{-}$\else $D_{\m}$\fi};
  \end{scope}
}
\end{tikzpicture}
