\begin{tikzpicture}[scale=0.75, yscale=2]

\node (A) at (0,0) {};
\node (Ap) at (0,1) {};
\node (B) at (0, 2) {};
\node (C) at (3, 0) {};

\begin{pgfonlayer}{nodelayer}
\node[label={below:$1$}] at (0, 0) {};
\node[ADE blue node, label={left:$y$}] at (0,1) {};
\node[ADE blue node] at (0,0) {};
\node[ADE blue node, label={below:$x^{3}$}] at (C) {};
\node[ADE blue node, label={left:$y^2$}] at (B) {};


\node[style=ADE white node, label={below:$x^{1}$}] (p1) at (1, 0) {};
\node[style=ADE black node, label={below:$x^{2}$}] (p2) at (2, 0) {};

\end{pgfonlayer}
\draw[ADE plain edge] (p1) to (p2);

\begin{pgfonlayer}{background}
\draw[gray, very thin] (0, 0) grid (3,2);
\draw[blue, very thick] (A.center) -- (B.center) -- (C.center);
\fill[blue!50, opacity=0.2] (A.center) -- (B.center) -- (C.center) -- cycle;
\draw[black, very thick, opacity=0.3] (0,0) to (3,0);

\end{pgfonlayer}

\begin{pgfonlayer}{main}
\begin{scope}[transparency group]
\draw[hlt] (p1.center) to (p2.center);
\end{scope}

\draw[BB cusp brace, color=blue] (2.5,0) to node[midway, yshift=2.5em,xshift=1.75em] {$1$} (0, 1.75);
\draw[BB cusp brace, color=blue] (0,2) to node[midway,yshift=0.1em, xshift=-2.9em] {$2$} (0, 0);
\node at (2.5,2.25) {\Large $A_2^{-}$};

\end{pgfonlayer}


\end{tikzpicture}