\input{ADE_macros.tikz}

\begin{tikzpicture}[]
\pgfmathsetmacro{\total}{0}
\foreach \m in {3,...,6}
{
\begin{scope}[shift={(\total, 0)}]
\ADEAn{\m}
\ifthenelse{\not\isodd{\npone}}{
\node at (\n + 0.5, 2.35) {\Large $A_\n$};
\draw[BB cusp brace, blue] (\n+0.75,.5) to node[midway, yshift=2.5em,xshift=1.75em] {$2$} (0.5, 2);
	\pgfmathsetmacro{\halfn}{int(\n/2)}
}{
\node at (\n+0.5, 2.35) {\Large $A_\n^-$};
\draw[BB cusp brace, blue] (\n+0.5,0) to node[midway, yshift=2.5em,xshift=1.75em] {$1$} (0, 1.75);
}
\begin{pgfonlayer}{background}
\draw[black, very thick, opacity=0.3] (0,0) to (\n+1,0);
\end{pgfonlayer}


\end{scope}
\pgfmathtruncatemacro{\newtotal}{\total + \m+3}
  \xdef\total{\newtotal} % make the new total globally available
}
\end{tikzpicture}
