\begin{tikzpicture}
\foreach \m [remember=\xnext as \xoff (initially 0),
    evaluate=\m as \xnext using \xoff+\m+4] in {3,...,6} {
  \begin{scope}[shift={(\xoff,0)}]
    \ADEAn{\m}
    \node[polygon title, below=7mm of lp.south]
      {\ifodd\m $A_{\m}$\else $A_{\m}^{-}$\fi};
  \end{scope}
}
\end{tikzpicture}
