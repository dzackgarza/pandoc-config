\begin{tikzpicture}
  % Baily-Borel boundary of Sterk's F_{En,2}: 0-cusps 1..5, 1-cusps named by
  % the 0-cusps in their closure.
  \matrix (curves) [matrix of math nodes, row sep=2mm] {
    |[cusp1, label={[cusp label]right:13}] (C13)| E_7^2C_2 \\
    |[cusp1, label={[cusp label]right:14}] (C14)| D_8^2 \\
    |[cusp1, label={[cusp label]right:15}] (C15)| A_{15}A_1(2) \\
    |[cusp1, label={[cusp label]right:34}] (C34)| A_{15}A_1(2) \\
    |[cusp1, label={[cusp label]right:35}] (C35)| D_{12}D_4 \\
    |[cusp1, label={[cusp label]right:45}] (C45)| D_8^2 \\
    |[cusp1, label={[cusp label]right:55}] (C55)| E_7^2C_2 \\
  };
  \matrix (points) [matrix of math nodes, row sep=6mm, left=2cm of curves] {
    |[cusp0] (v1)| 1 \\ |[cusp0] (v3)| 3 \\ |[cusp0] (v4)| 4 \\ |[cusp0] (v5)| 5 \\
  };
  \matrix (left curves) [matrix of math nodes, row sep=1.2cm, left=1.6cm of points] {
    |[cusp1, label={[cusp label]below:12}] (C12)| E_8^2 \\
    |[cusp1, label={[cusp label]below:245}] (C245)| D_{16}^+ \\
  };
  \node[cusp0, left=1.2cm of left curves] (v2) {$2$};

  \foreach \p/\c in {v2/C12, v2/C245, v1/C12, v4/C245, v5/C245, v1/C13, v1/C14,
      v1/C15, v3/C13, v3/C34, v3/C35, v4/C14, v4/C34, v4/C45, v5/C15, v5/C35,
      v5/C45, v5/C55}
    \draw[incidence] (\p) -- (\c);
\end{tikzpicture}
