\begin{tikzpicture}
  \matrix [matrix of math nodes, row sep=2mm, column sep=1.2cm] {
    |[cusp1] (C1)| C_1     & & |[cusp1] (D1)| C_1^{(3)}     &[1cm] \\
    |[cusp1] (C2)| C_2     & & |[cusp1] (D2)| C_2^{(3)}     & \\
    \vdots & |[cusp0] (P0)| p_0 & \vdots & |[cusp0] (P1)| p_1 \\
    |[cusp1] (C3)| C_{n-1} & & |[cusp1] (D3)| C_{m-1}^{(3)} & \\
    |[cusp1] (C4)| C_n     & \underline{N=3} & |[cusp1] (D4)| C_m^{(3)} & \\
    \mathbb{H}/\operatorname{SL}_2(\mathbb{Z}) & & \mathbb{H}/\Gamma'(3) & \\
  };
  \foreach \i in {1,...,4} {
    \draw[incidence] (P0) -- (C\i.east);
    \draw[incidence] (P0) -- (D\i.west);
    \draw[incidence] (P1) -- (D\i.east);
  }
\end{tikzpicture}
