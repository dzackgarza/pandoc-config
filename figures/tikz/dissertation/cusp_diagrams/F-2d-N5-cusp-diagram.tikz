\begin{tikzpicture}
  \matrix [matrix of math nodes, row sep=4mm, column sep=1.4cm] {
    & \underline{N=5} & &[1cm] \\
    |[cusp1] (C1)| C_1     & & |[cusp1] (D1)| C_1^{(5)}     & \\
    |[cusp1] (C2)| C_2     & & |[cusp1] (D2)| C_2^{(5)}     & |[cusp0] (P1)| p_1 \\
    \vdots & |[cusp0] (P0)| p_0 & \vdots & \\
    |[cusp1] (C3)| C_{n-1} & & |[cusp1] (D3)| C_{n-1}^{(5)} & |[cusp0] (P2)| p_2 \\
    |[cusp1] (C4)| C_n     & & |[cusp1] (D4)| C_n^{(5)}     & \\
    H/\operatorname{SL}_2(\mathbb{Z}) & & H/\Gamma'(5) & \\
  };
  \foreach \i in {1,...,4} {
    \draw[incidence] (P0) -- (C\i.east);
    \draw[incidence] (P0) -- node[cusp label, above] {$2$} (D\i.west);
    \draw[incidence] (P1) -- (D\i.east);
    \draw[incidence] (P2) -- (D\i.east);
  }
\end{tikzpicture}
