\begin{tikzpicture}
  % Empty integer axes, a template for lattice figures.
  \begin{axis}[
      xmin=0, xmax=22, ymin=0, ymax=11,
      grid=both,
      grid style={lattice grid, draw=dzg grid!25},
      major grid style={lattice grid},
      axis lines=middle,
      minor tick num=0,
      enlargelimits={abs=0.5},
      axis line style={latex-latex},
      ticklabel style={font=\tiny, fill=white},
      xlabel style={at={(ticklabel* cs:1)}, anchor=north west},
      ylabel style={at={(ticklabel* cs:1)}, anchor=south west},
      ytick={1,...,11},
      xtick={1,...,22},
    ]
  \end{axis}
\end{tikzpicture}
