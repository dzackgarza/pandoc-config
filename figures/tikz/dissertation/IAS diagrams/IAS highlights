\begin{tikzpicture}
  % Half of an IAS^2 cut open along p_0 p_17, with its unit lattice
  % triangulation, and the two Symington surgeries on sides p_2 p_3 and
  % p_14 p_15.
  \foreach \i/\x/\y in {0/0/0, 1/0/1, 2/-1/5, 3/-2/8, 4/-4/13, 5/-5/15,
      6/-7/18, 7/-8/19, 8/-10/20, 9/-11/20, 10/-13/19, 11/-14/18, 12/-16/15,
      13/-17/13, 14/-19/8, 15/-20/5, 16/-21/1, 17/-21/0}
    \coordinate (p\i) at (\x, \y);
  \coordinate (cut r) at ($(p2) + (-1, 2)$);
  \coordinate (cut l) at ($(p15) + (1, 2)$);

  \begin{scope}[on background layer]
    \draw[lattice grid] (-22, -1) grid (1, 21);
    \fill[ias region] (p0) \foreach \i in {1,...,17} { -- (p\i) } -- cycle;
    % The unit triangulation of the lattice: horizontal, vertical and both
    % diagonal lines through lattice points, inside the polygon.
    \begin{scope}
      \clip (p0) \foreach \i in {1,...,17} { -- (p\i) } -- cycle;
      \draw[ias edge, draw=dzg muted] (-22, -1) grid (1, 21);
      \foreach \c in {-43,...,22}
        \draw[ias edge, draw=dzg muted] (-22, \c + 22) -- ++(23, -23)
          (-22, \c) -- ++(23, 23);
    \end{scope}
  \end{scope}

  % Boundary edges; the surgery sides p_2 p_3 and p_14 p_15 are faint.
  \foreach \i [evaluate=\i as \j using int(\i + 1)] in {0, 1, 3, 4, ..., 13, 15, 16}
    \draw[fan ray] (p\i) -- (p\j);
  \draw[fan ray, opacity=0.3] (p2) -- (p3)  (p14) -- (p15);
  \draw[ias boundary, dashed, draw=dzg muted] (p0) -- (p17);

  \begin{scope}[on edge layer]
    \path[ias surgery, dashed] (p15) -- (cut l) -- (p14);
    \path[ias surgery, dashed] (p2) -- (cut r) -- (p3);
  \end{scope}
  \node[ias singularity] at (cut r) {};
  \node[ias singularity] at (cut l) {};

  % Points, labelled with their lattice coordinates.
  \foreach \i/\x/\y in {0/0/0, 1/0/1, 2/-1/5, 3/-2/8, 4/-4/13, 5/-5/15,
      6/-7/18, 7/-8/19, 8/-10/20}
    \node[stratum, label=above right:{$p_{\i}$ (\x,\y)}] at (p\i) {};
  \foreach \i/\x/\y in {9/-11/20, 10/-13/19, 11/-14/18, 12/-16/15,
      13/-17/13, 14/-19/8, 15/-20/5, 16/-21/1}
    \node[stratum, label=above left:{$p_{\i}$ (\x,\y)}] at (p\i) {};
  \node[stratum, label=left:{$p_{17}$ (-21,0)}] at (p17) {};
\end{tikzpicture}
