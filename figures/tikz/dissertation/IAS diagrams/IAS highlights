% The (18,0,0)_1 polygon P(lambda) at l_1..l_19 =
% (2,1,2,0,2,1,2,1,2,1,2,1,2,1,2,0,2,1,2), the smallest instance, with its
% unit triangulation and each vertex labelled by its lattice coordinates.
\begin{tikzpicture}[scale=0.8]
  \pic[ias labels=none] (P) {symington 18 0 0={2,1,2,0,2,1,2,1,2,1,2,1,2,1,2,0,2,1,2}};
  \begin{scope}[on background layer]
    \clip (P-p2) \foreach \i in {3,...,19} { -- (P-p\i) } -- cycle;
    \draw[lattice grid] (-22, -1) grid (1, 21);
    \foreach \c in {-43,...,22}
      \draw[lattice grid] (-22, \c + 22) -- ++(23, -23)  (-22, \c) -- ++(23, 23);
  \end{scope}
  \foreach \i/\x/\y in {2/0/0, 3/0/1, 4/-1/5, 5/-2/8, 6/-4/13, 7/-5/15,
      8/-7/18, 9/-8/19, 10/-10/20}
    \node[ias label, right=3pt] at (P-p\i) {$p_{\i}$ $(\x,\y)$};
  \foreach \i/\x/\y in {11/-11/20, 12/-13/19, 13/-14/18, 14/-16/15,
      15/-17/13, 16/-19/8, 17/-20/5, 18/-21/1, 19/-21/0}
    \node[ias label, left=3pt] at (P-p\i) {$p_{\i}$ $(\x,\y)$};
\end{tikzpicture}
