\begin{tikzpicture}[scale=2]
  % The IAS^2 of the (18,2,0) cusp: a 16-gon with boundary points p_0..p_15,
  % four Symington surgeries with singular points p_16..p_19, and the lines
  % ell_20, ell_21 joining opposite surgeries.
  \foreach \i/\x/\y/\where in {0/0/0/above right, 1/3/-3/above right,
      2/5/-4/above, 3/6/-4/above, 4/8/-3/above left, 5/11/0/left, 6/12/2/left,
      7/12/3/left, 8/11/5/left, 9/8/8/below left, 10/6/9/below,
      11/5/9/below, 12/3/8/below right, 13/0/5/right, 14/-1/3/right,
      15/-1/2/right}
    \coordinate[label={[label distance=4mm]\where:\Large $p_{\i}$}] (p\i) at (\x, \y);

  % Surgeries: the side from p_a to p_b of direction (dx,dy) has lattice
  % length 3; its middle third is cut out and folded to the singular point s.
  \foreach \s/\a/\b/\dx/\dy/\sx/\sy in {16/0/1/1/-1/1/0, 17/4/5/1/1/0/1,
      18/8/9/-1/1/-1/0, 19/12/13/-1/-1/0/-1} {
    \coordinate (s\s a) at ($(p\a) + (\dx, \dy)$);
    \coordinate (s\s b) at ($(p\a) + 2*(\dx, \dy)$);
    \coordinate (s\s) at ($(s\s a) + (\sx, \sy)$);
  }

  \begin{scope}[on background layer]
    \fill[ias region] (p0) \foreach \i in {1,...,15} { -- (p\i) } -- cycle;
    \draw[lattice grid] (-3, -5) grid (14, 10);
    \foreach \s in {16, 17, 18, 19}
      \path[ias surgery, dashed] (s\s a) -- (s\s) -- (s\s b) -- cycle;
  \end{scope}

  % Boundary edges v_i = l_i * (primitive direction).
  \foreach \a/\b/\where/\v in {
      1/2/below left/{v_1={1\over 2}\ell_1\cdot(2, -1)},
      2/3/below/{v_2=\ell_2\cdot(1, 0)},
      3/4/below right/{v_3={1\over 2}\ell_3\cdot(2, 1)},
      5/6/below right/{v_5={1\over 2}\ell_5\cdot (1,2)},
      6/7/right/{v_6=\ell_6\cdot(0, 1)},
      7/8/right/{v_7={1\over 2}\ell_7 \cdot(-1, 2)},
      9/10/above right/{v_9={1\over 2}\ell_9\cdot(-2, 1)},
      10/11/above/{v_{10}=\ell_{10}\cdot(-1, 0)},
      11/12/above left/{v_{11}={1\over 2}\ell_{11}\cdot(-2, -1)},
      13/14/left/{v_{13}={1\over 2}\ell_{13}\cdot(-1,-2)},
      14/15/left/{v_{14}=\ell_{14}\cdot(0, -1)},
      15/0/left/{v_{15}={1\over 2}\ell_{15}\cdot(1, -2)}}
    \draw[fan ray] (p\a) -- node[midway, \where, inner sep=6pt] {\Large $\v$} (p\b);

  % Surgery sides: the cut-out middle third is dashed.
  \foreach \s/\a/\b/\where/\v in {
      16/0/1/below left/{v_0=(\ell_0 + {1\over 2}\ell_{16})\cdot(1,-1)},
      17/4/5/below right/{v_4=(\ell_4 + {1\over 2}\ell_{17})\cdot(1,1)},
      18/8/9/above right/{v_8=(\ell_8 + {1\over 2}\ell_{18})\cdot(-1, 1)},
      19/12/13/above left/{v_{12}=(\ell_{12} + {1\over 2}\ell_{19})\cdot(-1, 1)}} {
    \draw[fan ray, -] (p\a) -- (s\s a);
    \draw[fan ray, -, dashed, opacity=0.4] (s\s a) -- (s\s b);
    \draw[fan ray] (s\s b) -- node[near start, \where, inner sep=6pt] {\Large $\v$} (p\b);
    \draw[ias edge, dashed, draw=dzg singular] ($(s\s a)!0.5!(s\s b)$) -- (s\s);
    \foreach \c in {s\s a, s\s b}
      \node[stratum] at (\c) {};
  }

  % Surgery vectors v_16..v_19 and the singular points they point to.
  \foreach \s/\where/\v in {16/above left/{v_{16} = {1\over 2}\ell_{16}\cdot(1,0)},
      17/left/{v_{17} = {1\over 2}\ell_{17}\cdot (0,1)},
      18/below right/{v_{18} = {1\over 2}\ell_{18}\cdot(-1,0)},
      19/right/{v_{19}={1\over 2}\ell_{19}\cdot(0,-1)}}
    \draw[fan ray, draw=dzg singular] (s\s a) -- node[pos=0.35, \where, inner sep=6pt] {\Large $\v$} (s\s);
  \draw[ias edge, dotted, draw=dzg singular]
    (s16) -- node[near start, right=6mm] {\Large $\ell_{20}$} (s18)
    (s17) -- node[near start, right=6mm] {\Large $\ell_{21}$} (s19);

  \foreach \i in {0,...,15}
    \node[ias singularity=1] at (p\i) {};
  \foreach \s/\where in {16/below right, 17/below left, 18/above left,
      19/above right}
    \node[ias singularity=1, label={[label distance=4mm]\where:\Large $p_{\s}$}]
      at (s\s) {};
\end{tikzpicture}
