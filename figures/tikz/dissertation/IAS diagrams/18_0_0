\begin{tikzpicture}[xscale=2]
  % The IAS^2 of the (18,0,0) cusp, cut open along the dashed segment p_2 p_19:
  % boundary points p_2..p_19, two Symington surgeries with singular points
  % p_1 and p_20, and zoomed insets of both surgeries.
  \foreach \i/\x/\y in {2/0/0, 3/0/2, 4/-1/6, 5/-4/15, 6/-6/20, 7/-7/22,
      8/-9/25, 9/-10/26, 10/-12/27, 11/-13/27, 12/-15/26, 13/-16/25,
      14/-18/22, 15/-19/20, 16/-21/15, 17/-24/6, 18/-25/2, 19/-25/0}
    \coordinate (p\i) at (\x, \y);
  % Surgery sides p_4 p_5 and p_16 p_17 have lattice length 3; their middle
  % thirds fold to the singular points p_1 and p_20.
  \coordinate (r1) at ($(p4)!1/3!(p5)$);
  \coordinate (r2) at ($(p4)!2/3!(p5)$);
  \coordinate (l1) at ($(p16)!1/3!(p17)$);
  \coordinate (l2) at ($(p16)!2/3!(p17)$);
  \coordinate (p1) at ($(r1) + (-1, 2)$);
  \coordinate (p20) at ($(l2) + (1, 2)$);

  \begin{scope}[on background layer]
    \fill[ias region] (p2) \foreach \i in {3,...,19} { -- (p\i) } -- cycle;
    \draw[lattice grid] (-27, -1) grid (2, 29);
  \end{scope}

  % Boundary edges v_i = l_i * (primitive direction), oriented p_2 -> p_19.
  \foreach \a/\b/\where/\v in {
      2/3/right/{v_2=\ell_2 (0,1)},
      3/4/above right/{v_3={1\over 2}\ell_{3}(-1,4)},
      5/6/above right/{v_5={1\over 2} \ell_5 (-2,5)},
      6/7/above right/{v_6=\ell_6 (-1,2)},
      7/8/above right/{v_7={1\over 2}\ell_7 (-2,3)},
      8/9/above right/{v_8=\ell_8 (-1,1)},
      9/10/above right/{v_9={1\over 2}\ell_9 (-2,1)},
      10/11/above/{v_{10} = \ell_{10}(-1,0)},
      11/12/above left/{v_{11}={1\over 2}\ell_{11}(-2,-1)},
      12/13/above left/{v_{12}=\ell_{12}(-1,-1)},
      13/14/above left/{v_{13}={1\over 2}\ell_{13}(-2,-3)},
      14/15/above left/{v_{14}= \ell_{14}(-1,-2)},
      15/16/above left/{v_{15}={1\over 2}\ell_{15}(-2,-5)},
      17/18/above left/{v_{17}={1\over 2}\ell_{17}(-1,-4)},
      18/19/left/{v_{18}=\ell_{18}(0,-1)}}
    \draw[fan ray] (p\a) -- node[midway, \where, inner sep=6pt] {\Large $\v$} (p\b);

  % The two surgery sides.
  \draw[fan ray, -] (p4) -- (r1);
  \draw[fan ray, -, dashed, opacity=0.5] (r1) -- (r2);
  \draw[fan ray] (r2) -- node[midway, above right]
    {\Large $v_4=(\ell_4 + {1\over 2}\ell_{1}) (-1,3)$} (p5);
  \draw[fan ray, -] (p16) -- node[midway, left]
    {\Large $v_{16}=(\ell_{16} + {1\over 2}\ell_{19})(-1,-3)$} (l1);
  \draw[fan ray, -, dashed] (l1) -- (l2);
  \draw[fan ray] (l2) -- (p17);
  \begin{scope}[on edge layer]
    \draw[ias surgery, dashed] (r1) -- (p1) -- (r2);
    \draw[ias surgery, dashed] (l1) -- (p20) -- (l2);
    \draw[fan ray, dotted, draw=dzg singular] (r1) -- (p1);
    \draw[fan ray, dotted, draw=dzg singular] (l2) -- (p20);
  \end{scope}
  \draw[ias edge, dashed, draw=dzg singular] (p1) -- ++(3/12, 3/12)
    (p20) -- ++(-3/12, 3/12);
  \node[left=5mm] at (r1) {\Large $v_1 = {1\over 2}\ell_1(-1,2)$};
  \node[right=5mm] at (l2) {\Large $v_{19} = {1\over 2}\ell_{19}(1,2)$};

  % The cut.
  \draw[ias boundary, dashed, draw=dzg muted] (p2) -- (p19);

  % Points and multiplicities.
  \foreach \c in {r1, r2, l1, l2}
    \node[stratum] at (\c) {};
  \foreach \i in {3,...,9}
    \node[ias singularity=1, label={[label distance=4mm]below left:\Large $p_{\i}$}]
      at (p\i) {};
  \foreach \i in {12,...,18}
    \node[ias singularity=1, label={[label distance=4mm]below right:\Large $p_{\i}$}]
      at (p\i) {};
  \node[ias singularity=1, label={[label distance=5mm]below:\Large $p_{10}$}] at (p10) {};
  \node[ias singularity=1, label={[label distance=5mm]below:\Large $p_{11}$}] at (p11) {};
  \node[ias singularity=4, label={[label distance=5mm]225:\Large $p_2$}] at (p2) {};
  \node[ias singularity=4, label={[label distance=5mm]315:\Large $p_{19}$}] at (p19) {};
  \node[ias singularity, label={[label distance=5mm]180:\Large $p_1$}] at (p1) {};
  \node[ias singularity, label={[label distance=5mm]0:\Large $p_{20}$}] at (p20) {};

  % Zoomed insets of the two surgeries, each joined by dotted lines to the
  % rectangle it magnifies.
  \coordinate (la1) at (-25, 23);
  \coordinate (la2) at (-21, 27);
  \coordinate (ls) at (-21, 25);
  \draw[lattice grid, step=0.5] (-26, 22) grid ++(6, 6);
  \draw (-26, 22) rectangle ++(6, 6);
  \scoped[on background layer] \path[ias surgery, dashed] (la1) -- (ls) -- (la2);
  \draw[fan ray, -] (-20, 28) -- (la2);
  \draw[fan ray, -, dashed, opacity=0.5] (la2) -- (la1);
  \draw[fan ray] (la1) -- (-26, 22);
  \draw[fan ray, draw=dzg singular] (la1) -- (ls);
  \draw[ias edge, dashed, draw=dzg singular] ($(la1)!0.88!(la2)$) -- (ls);
  \node[above right=0cm and 4.5cm of la1] {\Huge $v_{19} = {1\over 2}\ell_{19}(1,2)$};
  \draw[dzg muted] (-24, 8) rectangle ++(4, 5);
  \draw[ias boundary, dotted] (-24, 13) -- (-26, 28) (-24, 8) -- (-26, 22);

  \coordinate (ra1) at (0, 23);
  \coordinate (ra2) at (-4, 27);
  \coordinate (rs) at (-4, 25);
  \draw[lattice grid, step=0.5] (-5, 22) grid ++(6, 6);
  \draw (-5, 22) rectangle ++(6, 6);
  \scoped[on background layer] \path[ias surgery, dashed] (ra1) -- (rs) -- (ra2);
  \draw[fan ray, -] (1, 22) -- (ra1);
  \draw[fan ray, -, dashed, opacity=0.5] (ra2) -- (ra1);
  \draw[fan ray] (ra2) -- (-5, 28);
  \draw[fan ray, draw=dzg singular] (ra1) -- (rs);
  \draw[ias edge, dashed, draw=dzg singular] ($(ra1)!0.88!(ra2)$) -- (rs);
  \node[below left=-1cm and 4cm of ra1] {\Huge $v_{1} = {1\over 2}\ell_{1} (-1,2)$};
  \draw[dzg muted] (-5, 8) rectangle ++(4, 5);
  \draw[ias boundary, dotted] (-1, 13) -- (1, 28) (-1, 8) -- (1, 22);

  \foreach \c in {la1, la2, ra1, ra2}
    \node[stratum] at (\c) {};
  \foreach \c in {ls, rs}
    \node[ias singularity] at (\c) {};
\end{tikzpicture}
