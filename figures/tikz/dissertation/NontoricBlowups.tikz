\begin{tikzpicture}
  % Left: nine non-toric blowup points on the boundary square. Right: the same
  % square after the blowups, each point replaced by its exceptional curve.
  \foreach \dx in {0, 7}
    \draw[curve component, shift={(\dx, 0)}] (-1, 0) -- (5, 0)  (-1, 4) -- (5, 4)
      (0, -1) -- (0, 5)  (4, -1) -- (4, 5);
  \node at (5.5, 2) {$=$};

  % Blowup point and the direction normal to its boundary line.
  \foreach \x/\y/\normal in {1/0/90, 2/0/90, 3/0/90, 1/4/90, 3/4/90,
      0/1/0, 0/3/0, 4/1/0, 4/3/0} {
    \node[nontoric blowup] at (\x, \y) {};
    \draw[exceptional curve] ([shift={(7, 0)}] \x, \y) ++(\normal:0.5)
      -- ++(\normal+180:1);
  }
\end{tikzpicture}
