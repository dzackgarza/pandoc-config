\begin{tikzpicture}[scale=\textwidth/10cm]
  % a loop f_0 in X contracted to its basepoint
  \draw (-3,0) ellipse (3cm and 2cm);
  \draw[distinguished curve] (-3,0) ellipse (2cm and 1cm);
  \foreach \c/\a/\b in {-3.4/1.6/.9, -3.8/1.2/.7, -4.2/.8/.5, -4.6/.4/.2}
    \draw[dzg accent, dashed] (\c,0) ellipse (\a cm and \b cm);
  \node[point] at (-5,0) {};
  \node at (-3,-2.5) {$X$};
  \node at (-2,1.1) {\small $f_0$};

  % the circle and its basepoint
  \draw[distinguished curve] (-8,0) circle (1cm);
  \node[point] at (-8,-1) {};
  \node at (-8,-1.5) {$S^1$};

  \draw[map arrow] (-7.5,1) to[curve through={(-5.56,1.75)}] (-4,1);
  \node at (-5.5,2.2) {$f$};
\end{tikzpicture}
