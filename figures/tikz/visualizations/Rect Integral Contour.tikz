\begin{tikzpicture}
\begin{axis}[complex plane, xmin=-10, xmax=10, ymin=-2, ymax=2,
    xtick={0}, ytick={0}]
  \node[font=\tiny, anchor=north west] at (axis cs:-5,0) {-R};
  \node[font=\tiny, anchor=north east] at (axis cs:5,0) {R};
  \node[font=\tiny, anchor=north east] at (axis cs:5,-5) {R - ib};
  \node[font=\tiny, anchor=north west] at (axis cs:-5,-5) {-R - ib};
  \node[font=\tiny, anchor=north west] at (axis cs:5,6) {$\mathbb{C}$};

  % the rectangle, oriented counterclockwise
  \draw[contour] (axis cs:-5,0) -- (axis cs:-5,-5);
  \draw[contour] (axis cs:5,-5) -- (axis cs:5,0);
  \draw[contour] (axis cs:5,0) -- (axis cs:-5,0);
  \draw[contour] (axis cs:-5,-5) -- (axis cs:5,-5);
\end{axis}
\end{tikzpicture}
