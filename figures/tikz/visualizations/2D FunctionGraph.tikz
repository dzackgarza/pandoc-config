\begin{tikzpicture}[domain=0:4]
  \draw[lattice grid] (-0.1,-1.1) grid (3.9,3.9);
  \draw[->] (-0.2,0) -- (4.2,0) node[right] {$x$};
  \draw[->] (0,-1.2) -- (0,4.2) node[above] {$f(x)$};
  \draw[dzg singular] plot (\x,\x) node[right] {$f(x) = x$};
  \draw[dzg accent] plot (\x,{sin(\x r)}) node[right] {$f(x) = \sin x$};
  \draw[dzg muted] plot (\x,{0.05*exp(\x)}) node[right] {$f(x) = \frac{1}{20} \mathrm e^x$};
\end{tikzpicture}
