\begin{tikzpicture}[scale=\textwidth/10cm]
  \coordinate (ll) at (-3,-2);
  \coordinate (lr) at (3,-2);
  \coordinate (ul) at (-3,2);
  \coordinate (ur) at (3,2);
  % side and top of the cylinder
  \shade[shading angle=90, opacity=0.2]
    (ll) arc (-180:-60:3cm and .75cm) -- +(0,4) arc (-60:-180:3cm and .75cm) -- cycle;
  \shade[shading angle=270, opacity=0.2]
    (lr) arc (0:-60:3cm and .75cm) -- +(0,4) arc (-60:0:3cm and .75cm) -- cycle;
  \draw[top color=dzg accent]
    (ll) arc (-180:0:3cm and .75cm) -- (ur) arc (0:-180:3cm and .75cm) -- cycle;
  \draw[dzg singular, top color=dzg accent, opacity=0.9]
    (ul) arc (-180:180:3cm and .75cm);
  % the boundary circles
  \draw[dzg singular, dashed] (ll) arc (180:0:3cm and .75cm);
  \draw[dzg singular] (ll) arc (180:360:3cm and .75cm);
  \node at (0,-3.5) {$B^1 \times B^0$};
\end{tikzpicture}
