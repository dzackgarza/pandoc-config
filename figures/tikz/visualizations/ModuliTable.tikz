\begin{tikzpicture}
\begin{axis}[hide axis, xmin=-12, xmax=18, ymin=-4, ymax=10, disabledatascaling]
  % three columns, at x = -10, 0, 10
  \draw (axis cs:-10,9) -- (axis cs:-10,0);
  \draw (axis cs:-14,0) -- (axis cs:-6,0);
  \draw (axis cs:0,9) -- (axis cs:0,0);
  \draw (axis cs:-4,0) -- (axis cs:4,0);
  \draw (axis cs:10,9) -- (axis cs:10,0);
  \draw (axis cs:6,0) -- (axis cs:14,0);

  \node[point, dzg accent] (left1) at (axis cs:-10,6) {};
  \node[point, dzg accent] (center1) at (axis cs:0,6) {};
  \node[point, dzg accent] (right1) at (axis cs:10,6) {};
  \node[point, dzg accent] at (axis cs:-10,3) {};
  \node[point, dzg accent] at (axis cs:0,3) {};
  \node[point, dzg accent] at (axis cs:10,3) {};
  \node[point, dzg accent] at (axis cs:-10,0) {};
  \node[point, dzg accent] at (axis cs:0,0) {};
  \node[point, dzg accent] at (axis cs:10,0) {};
  \node[right=1mm of left1, font=\tiny] {$(\eps + x - 1)$};
  \node[right=1mm of center1, font=\tiny] {$(x)(\eps, x - 1)$};
  \node[right=1mm of right1, font=\tiny] {$(x(x-1), \eps)$};

  \draw[distinguished curve] (axis cs:-10,6) -- (axis cs:-7,9);
  \draw[distinguished curve] (axis cs:-10,3) -- (axis cs:-7,3);
  \draw[distinguished curve] (axis cs:0,3) -- (axis cs:3,3);
  \draw[distinguished curve] (axis cs:0,0) -- (axis cs:3,0);
  \draw[distinguished curve] (axis cs:10,0) -- (axis cs:13,0);
\end{axis}
\end{tikzpicture}
