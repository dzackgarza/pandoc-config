\begin{tikzpicture}
  % Grid with its integer coordinates
  \draw[lattice grid] (-2,-2) grid (10,10);
  \foreach \i in {-2,...,10} {
    \node[font=\tiny, below] at (\i,-2) {$\i$};
    \node[font=\tiny, left] at (-2,\i) {$\i$};
  }

  % Text
  \node (x) at (-0.5,0.5) {$O$};

  % Lines
  \draw (0,3) -- (1,4);
  \draw (-1,2.5) -- (-0.5,2) -- (0,2.5);

  % Paths between two points, each through one intermediate point
  \draw (-2,-4) to[curve through={(-1.2,-3.1)}] (3,-3);
  \draw (-2,-4) to[curve through={(0.63,-4.17)}] (3,-3);
  \draw (-2,-4) to[curve through={(0.5,-3.3)}] (3,-3);

  % Smooth curves through listed points
  \draw[dzg accent] (0,10) to[curve through={(2,11)}] (4,10);
  \draw[dzg accent] (4.5,10) to[curve through={(5.52,9.41) (5.65,10.59)}] (5,12);

  % Circles and ellipses
  \node[point, dzg muted] at (0,0) {};
  \filldraw[draw=dzg singular, fill=dzg region] (0,7) circle (1.5);
  \fill[dzg highlight] (2,5) circle [x radius=1.5, y radius=0.5];

  % Circular arc: start angle, end angle, radius
  \draw[dzg singular, ->] (7,3) arc (0:220:1);

  % Rectangle between two opposite corners
  \draw[dzg accent] (2,9) rectangle (3,7);

  % Polygon
  \draw[dzg muted] (4,6) -- (6,6) -- (6,10) -- cycle;

  % Function plots
  \draw[dzg singular] plot (\x,\x) node[right] {$f(x) = x$};
  \draw[dzg accent] plot (\x,{sin(\x r)}) node[right] {$f(x) = \sin x$};
  \draw[dzg muted, domain=-2:8] plot (\x,{exp(\x-6)}) node[right]
    {$f(x) = \frac{1}{20} \mathrm e^x$};
  \draw[scale=0.5, domain=-4:4, smooth, variable=\y] plot ({\y*\y},{\y})
    node[right] {$x = y^2$};
\end{tikzpicture}
