\begin{tikzpicture}
  % a group as a one-object category: the object G and its endomorphisms
  \node (G) {G};
  \foreach \h/\w/\g in {0.45/0.12/g_1, 1.05/0.45/g_2, 1.65/0.75/g_3,
      2.25/1.05/g_4, 2.95/1.4/\cdots}
    \draw[->] (G.north) to[curve through={(-\w,0.6*\h) (0,\h) (\w,0.6*\h)}]
      (G.north) node[above] at (0,\h) {$\g$};
\end{tikzpicture}
