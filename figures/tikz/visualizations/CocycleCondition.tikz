\begin{tikzpicture}[x=0.75pt, y=0.75pt, yscale=-1]
  % P^3 and the curve C in it
  \node[draw, circle, minimum size=12cm, inner sep=0pt,
    label={[scale=2]$\PP^3$}] at (320,150) {};
  \draw[distinguished curve] (152.5,225) to[curve through={(201,208) (313,135)
    (350,62) (287,42) (254,76) (251,115)}] (270,135);
  \draw[distinguished curve] (339.5,151) to[curve through={(452.5,104)}] (503.5,54);
  \node[scale=2] at (350,180) {$C$};

  % P^1
  \draw[distinguished curve] (-50,400) -- (-50,100);
  \draw (-70,400) -- (-30,400);
  \draw (-70,100) -- (-30,100);
  \node[scale=2] at (-25,80) {$\PP^1$};

  % the embedding
  \draw[map arrow, right hook->] (-30,200) -- (150,200)
    node[midway, above=8pt, scale=2] {$\iota$};
\end{tikzpicture}
