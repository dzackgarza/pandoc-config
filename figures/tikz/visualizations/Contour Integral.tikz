% The contour for int_0^infty log(x) / (1 + x^3) dx: the boundary of the
% quarter disc of radius R, the poles r_k of 1/(1 + z^3) (the cube roots of -1,
% drawn on the unit circle), and the branch cut of log z along the negative
% imaginary axis, which keeps log z holomorphic on the closed sector.
\begin{tikzpicture}
  \pic {quarter disc contour};
  \draw[branch cut] (0,0) -- (0,-1.2);
  \node[point, label={[font=\small]above:$r_1 = -1$}] at (180:1) {};
  \node[point, label={[font=\small]right:$r_2 = e^{i\pi/3}$}] at (60:1) {};
  \node[point, label={[font=\small]right:$r_3 = e^{-i\pi/3}$}] at (-60:1) {};
\end{tikzpicture}
