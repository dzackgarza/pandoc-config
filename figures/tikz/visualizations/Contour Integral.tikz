\begin{tikzpicture}
\begin{axis}[complex plane, xmin=-6, xmax=12, ymin=-2, ymax=10,
    xtick={0}, ytick={0}]
  \node[font=\tiny, anchor=north east] at (axis cs:0,10) {$iR$};
  \node[font=\tiny, anchor=north east] at (axis cs:10,0) {$R$};
  \node[font=\tiny, anchor=north west] at (axis cs:9,11) {$\mathbb{C}$};

  % poles
  \node[point, label={[font=\tiny]south east:$r_2 = e^{i\pi/3}$}] at (60:1cm) {};
  \node[point, label={[font=\tiny]north west:$r_1 = -1$}] at (180:1cm) {};
  \node[point, label={[font=\tiny]south east:$r_3 = e^{-i\pi/3}$}] at (-60:1cm) {};

  % the contour Gamma: [0,R], the quarter circle, [iR,0]
  \draw[contour, domain=0:90] plot ({10*cos(\x)},{10*sin(\x)});
  \draw[contour] (axis cs:0,0) -- (axis cs:10,0);
  \draw[contour] (axis cs:0,10) -- (axis cs:0,0);
  \node[font=\tiny, anchor=north west] at (51.43:4cm) {$\Gamma$};

  \draw[branch cut] (axis cs:0,0) -- (axis cs:0,-5);
\end{axis}
\end{tikzpicture}
