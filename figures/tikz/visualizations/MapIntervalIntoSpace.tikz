\begin{tikzpicture}[scale=\textwidth/10cm]
  % the interval B^0 and its endpoints
  \draw[distinguished curve] (-3,0) -- (-1,0);
  \node[point, dzg singular] at (-3,0) {};
  \node[point, dzg singular] at (-1,0) {};
  \node at (-2,-.5) {$B^0$};

  % the space X, two paths f, g from p to q, and a homotopy between them
  \coordinate (p) at (0,0);
  \coordinate (q) at (4,0);
  \draw (2,0) circle [x radius=2.5, y radius=1.5];
  \node at (4.5,0.8) {$X$};
  \draw[contour] (p) to[curve through={(1.9,0.76)}] (q);
  \node[above] at (1.9,0.76) {$f$};
  \foreach \h in {0.57, 0.41, 0.24, 0.07, -0.11}
    \draw[dashed] (p) to[curve through={(2,\h)}] (q);
  \draw[contour] (p) to[curve through={(2.2,-0.55)}] (q);
  \node[below] at (2.2,-0.55) {$g$};
  \node[point, dzg singular, label=left:$p$] at (p) {};
  \node[point, dzg singular, label=right:$q$] at (q) {};

  % the two maps
  \draw[map arrow] (-2,.2) to[curve through={(-1,1.65) (0.33,1.41)}] (1,1);
  \draw[map arrow] (-2,-1) to[curve through={(-1,-1.89) (0.33,-1.44)}] (1,-1);
\end{tikzpicture}
