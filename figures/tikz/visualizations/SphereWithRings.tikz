\begin{tikzpicture}[scale=\textwidth/2cm]
\begin{axis}[hide axis, axis equal, samples=15]
  % the unit sphere, as two hemispheres
  \addplot3[surf, dzg muted, faceted color=dzg muted, opacity=0.5, samples=20,
      z buffer=sort, domain=0:360, y domain=0:1]
    ({cos(x)*y}, {sin(x)*y}, {sqrt(1-(cos(x)*y)^2-(sin(x)*y)^2)});
  \addplot3[surf, dzg muted, faceted color=dzg muted, opacity=0.5, samples=20,
      z buffer=sort, domain=0:360, y domain=0:1]
    ({cos(x)*y}, {sin(x)*y}, {-sqrt(1-(cos(x)*y)^2-(sin(x)*y)^2)});

  % circles of angular radius \a about the point with angles (\b, \c):
  % a great circle, then smaller ones shrinking to that point
  \pgfmathsetmacro{\b}{30.0}
  \pgfmathsetmacro{\c}{-15.0}
  \pgfmathsetmacro{\a}{90.0}
  \addplot3[distinguished curve, domain=0:360, samples=40] (
    {(sin(\a)*cos(\b)*cos(\c))*cos(x)+(sin(\a)*sin(\c))*sin(x)-(cos(\a)*sin(\b)*cos(\c))},
    {-(sin(\a)*cos(\b)*sin(\c))*cos(x)+(sin(\a)*cos(\c))*sin(x)+(cos(\a)*sin(\b)*sin(\c))},
    {(sin(\a)*sin(\b))*cos(x)+cos(\a)*cos(\b)});
  \pgfmathsetmacro{\a}{60.0}
  \addplot3[dzg accent, domain=0:360, samples=40] (
    {(sin(\a)*cos(\b)*cos(\c))*cos(x)+(sin(\a)*sin(\c))*sin(x)-(cos(\a)*sin(\b)*cos(\c))},
    {-(sin(\a)*cos(\b)*sin(\c))*cos(x)+(sin(\a)*cos(\c))*sin(x)+(cos(\a)*sin(\b)*sin(\c))},
    {(sin(\a)*sin(\b))*cos(x)+cos(\a)*cos(\b)});
  \pgfmathsetmacro{\a}{10.0}
  \addplot3[dzg accent, domain=0:360, samples=20] (
    {(sin(\a)*cos(\b)*cos(\c))*cos(x)+(sin(\a)*sin(\c))*sin(x)-(cos(\a)*sin(\b)*cos(\c))},
    {-(sin(\a)*cos(\b)*sin(\c))*cos(x)+(sin(\a)*cos(\c))*sin(x)+(cos(\a)*sin(\b)*sin(\c))},
    {(sin(\a)*sin(\b))*cos(x)+cos(\a)*cos(\b)});
  \pgfmathsetmacro{\a}{5.0}
  \addplot3[dzg accent, domain=0:360, samples=10] (
    {(sin(\a)*cos(\b)*cos(\c))*cos(x)+(sin(\a)*sin(\c))*sin(x)-(cos(\a)*sin(\b)*cos(\c))},
    {-(sin(\a)*cos(\b)*sin(\c))*cos(x)+(sin(\a)*cos(\c))*sin(x)+(cos(\a)*sin(\b)*sin(\c))},
    {(sin(\a)*sin(\b))*cos(x)+cos(\a)*cos(\b)});
\end{axis}
\end{tikzpicture}
