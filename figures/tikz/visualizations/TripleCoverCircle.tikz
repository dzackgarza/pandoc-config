\begin{tikzpicture}[declare function={f(\x)=0.2*sin(\x)+\x/1000;}]
  % the connected triple cover of the circle, drawn as a helix of three turns
  % closed up by a strand from the top back to the bottom. Each piece is drawn
  % over a white halo, so a later piece passes over an earlier one.
  \foreach \a in {-50,-30,...,950}
    \draw[curve component, over strand]
      plot[variable=\x, domain=\a:\a+20, samples=8, smooth] ({cos(\x)},{f(\x)});
  \draw[curve component, over strand]
    ({cos(970)},{f(970)}) to[curve through={(-0.05,0.74) (0.3,0.25) (0.48,-0.22)}]
    ({cos(-50)},{f(-50)});
  % the base circle and the covering map
  \draw[curve component] (0,-2) arc (-90:270:1cm and 0.2cm);
  \draw[map arrow] (0,-0.4) -- (0,-1.4) node[midway, right] {$p$};
\end{tikzpicture}
