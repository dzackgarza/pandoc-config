% Animation frames: a box under the surface z = 2 + 0.3 sin(2y) over
% [1,4] x [0, 2.2 pi]; the box spans [1.8,3.2] x [0.8 pi, \objymax].
\tdplotsetmaincoords{60}{110}
\foreach \frame in {0,...,35} {
\pgfmathsetmacro{\objymax}{1.6*pi+0.5*sin(10*\frame)*pi}
\begin{tikzpicture}[tdplot_main_coords,
    declare function={surf(\y)=2+0.3*sin(deg(2*\y));}]
  \draw[->] (0,0,0) coordinate (O) -- (5,0,0) node[pos=1.1] {$x$};
  \draw[->] (O) -- (0,5,0) node[pos=1.1] {$y$};
  \draw[->] (O) -- (0,0,5) node[pos=1.1] {$z$};
  % top of the box, on the surface
  \draw plot[variable=\y, domain=0.8*pi:\objymax, smooth] (3.2,\y,{surf(\y)})
      coordinate (T1)
    -- plot[variable=\y, domain=\objymax:0.8*pi, smooth] (1.8,\y,{surf(\y)})
      coordinate (T3) -- cycle;
  % bottom of the box and its vertical edges
  \draw (3.2,0.8*pi,0) coordinate (B4) -- (3.2,\objymax,0) coordinate (B1)
    -- (1.8,\objymax,0) coordinate (B2) -- (1.8,0.8*pi,0) coordinate (B3) -- cycle;
  \path (3.2,0.8*pi,{surf(0.8*pi)}) coordinate (T4)
    (1.8,\objymax,{surf(\objymax)}) coordinate (T2);
  \foreach \i in {1,...,4} \draw (B\i) -- (T\i);
  % the surface, shaded in two halves
  \foreach \a/\b in {0/1.1*pi, 1.1*pi/2.2*pi}
    \path[opacity=0.3, left color=dzg accent, right color=dzg accent,
        middle color=dzg region, shading angle=72]
      plot[variable=\y, domain=\a:\b, smooth] (4,\y,{surf(\y)})
      -- plot[variable=\y, domain=\b:\a, smooth] (1,\y,{surf(\y)}) -- cycle;
  \draw plot[variable=\y, domain=0:2.2*pi, smooth] (4,\y,{surf(\y)})
    -- plot[variable=\y, domain=2.2*pi:0, smooth] (1,\y,{surf(\y)}) -- cycle;
\end{tikzpicture}}
