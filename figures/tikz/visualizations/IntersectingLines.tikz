\begin{tikzpicture}[gridded]
  % two named paths, and the segment between their intersection points
  \draw[dzg singular, name path=line] (0,0) -- (4,3);
  \draw[dzg accent, name path=curve] (1,-0.5)
    to[curve through={(1.6,1) (2.2,1.9) (2.8,2.3)}] (3,2);
  \draw[dzg muted, name intersections={of=line and curve, by={A, B}}] (A) -- (B);
  \node[above] at (A) {A};
  \node[below] at (B) {B};
\end{tikzpicture}
