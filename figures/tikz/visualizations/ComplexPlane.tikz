\begin{tikzpicture}
\begin{axis}[complex plane, xmin=-6, xmax=6, ymin=-4, ymax=4,
    xtick={-3,-1,1,3}, ytick={-3,-1,1,3}, axis on top]
  % nested regions |z| < 1, |z| < 3, |z| < 5
  \fill[dzg region] (0,0) circle [radius=5];
  \fill[dzg highlight] (0,0) circle [radius=3];
  \fill[dzg accent!40] (0,0) circle [radius=1];

  \draw[->, dzg muted] (axis cs:3,3) -- (axis cs:4,4);
  \draw[->, dzg muted] (axis cs:-3,3) -- (axis cs:-4,4);
  \draw[->, dzg muted] (axis cs:3,-3) -- (axis cs:4,-4);
  \draw[->, dzg muted] (axis cs:-3,-3) -- (axis cs:-4,-4);

  \node[font=\tiny, anchor=north west] at (axis cs:0,1) {Region 1};
  \node[font=\tiny, anchor=north west] at (axis cs:1,2) {Region 2};
  \node[font=\tiny, anchor=north west] at (axis cs:2,3) {Region 3};
  \node[anchor=north east] at (axis cs:2.5,5) {$\mathbb{C}$};
\end{axis}
\end{tikzpicture}
