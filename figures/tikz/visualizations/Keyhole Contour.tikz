\begin{tikzpicture}
  % keyhole contour around the singularity a: the circle of radius r, the cut
  % in to a, the small circle around a, the cut back out
  \draw[contour={0.2,0.45,0.7,0.86,0.98}, fill=dzg region]
    (47.5:2) arc (47.5:360:2) arc (0:42.5:2)
    -- +(225:0.5) arc (25:0:0.25) arc (360:65:0.25) -- cycle;
  \node[point, dzg singular, label={[font=\footnotesize, dzg singular]right:$a$}]
    at (45:1.25) {};
  \draw[->] (0,0) -- node[sloped, above] {$r$} (330:2);
  \draw[->] (-3,0) -- (3,0) node[right] {$\Re$};
  \draw[->] (0,-3) -- (0,3) node[above] {$\Im$};
\end{tikzpicture}
