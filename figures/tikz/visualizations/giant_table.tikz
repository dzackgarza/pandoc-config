\begin{tikzpicture}[rotate=-90, scale=0.2]
  % 50 x 50 table; cell (i,j) is the unit square [i-1,i] x [j-1,j].
  % The diagonal j = i and the band j = i + 2 are marked.
  \foreach \i in {1,...,50} \fill[dzg accent] (\i-1,\i-1) rectangle ++(1,1);
  \foreach \i in {1,...,48} \fill[dzg singular] (\i-1,\i+1) rectangle ++(1,1);
  \draw (0,0) grid (50,50);
\end{tikzpicture}
