\begin{tikzpicture}[scale=\textwidth/5cm]
  % two 2-spheres, each with its equator and a meridian; back halves dashed
  \foreach \c in {-4,0} {
    \begin{scope}[shift={(\c,0)}]
      \draw (-1,0) arc (180:360:1cm and 0.5cm);
      \draw[dashed] (-1,0) arc (180:0:1cm and 0.5cm);
      \draw (0,1) arc (90:270:0.5cm and 1cm);
      \draw[dashed] (0,1) arc (90:-90:0.5cm and 1cm);
      \draw (0,0) circle (1cm);
      \shade[ball color=dzg region, opacity=0.2] (0,0) circle (1cm);
      \node at (0,-1.5) {$S^2$};
    \end{scope}
  }
  \draw[map arrow] (-4,1.2) to[curve through={(-3.44,1.49) (-2.11,1.08)}] (-1,.5);
  \node at (-3,1.5) {$f$};
\end{tikzpicture}
