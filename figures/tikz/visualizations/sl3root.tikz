\begin{tikzpicture}
\begin{axis}[complex plane, xmin=-10, xmax=10, ymin=-2, ymax=2,
    xtick={0}, ytick={0}]
  % the root system A_2 of sl(3,C): the lines through +-alpha, +-beta, +-(alpha+beta)
  \draw[distinguished curve] (axis cs:-5,-5) -- (axis cs:5,5);
  \draw[distinguished curve] (axis cs:-5,5) -- (axis cs:5,-5);
  \draw[distinguished curve] (axis cs:-5,0) -- (axis cs:5,0);
  \node[font=\tiny, anchor=north west] at (axis cs:-4,5) {$\beta$};
  \node[font=\tiny, anchor=north west] at (axis cs:5,0) {$\alpha$};
  \node[font=\tiny, anchor=north west] at (axis cs:5,5) {$\alpha + \beta$};
  \node[font=\tiny, anchor=north west] at (axis cs:6,8) {$\liesl(3, \CC)$};
\end{axis}
\end{tikzpicture}
