% Spherical coordinates (r, theta, phi) of a vector v.
\tdplotsetmaincoords{60}{25}
\pgfmathsetmacro{\rvec}{1}
\pgfmathsetmacro{\thetavec}{50}
\pgfmathsetmacro{\phivec}{15}
\begin{tikzpicture}[scale=5, tdplot_main_coords]
  \coordinate (O) at (0,0,0);
  \node[point, label=below left:O] at (O) {};
  % P has spherical coordinates (r, theta, phi); tikz-3dplot also defines Pxy
  \tdplotsetcoord{P}{\rvec}{\thetavec}{\phivec}
  \node[point, label=above right:$\mathbf v$] at (P) {};

  \draw[->] (0,0,0) -- (1,0,0) node[anchor=north east] {$x$};
  \draw[->] (0,0,0) -- (0,1,0) node[anchor=north west] {$y$};
  \draw[->] (0,0,0) -- (0,0,1) node[anchor=south] {$z$};

  % the vector, its projection to the xy-plane, and the vertical drop
  \draw[->, dzg singular] (O) -- (P);
  \draw[dashed, dzg singular] (O) -- (Pxy);
  \draw[dashed, dzg singular] (P) -- (Pxy);

  % the angle phi in the xy-plane, and theta in the plane through z and v
  \tdplotdrawarc{(O)}{0.2}{0}{\phivec}{anchor=north}{$\phi$}
  \tdplotsetthetaplanecoords{\phivec}
  \tdplotdrawarc[tdplot_rotated_coords]{(0,0,0)}{0.2}{0}{\thetavec}
    {anchor=south west}{$\theta$}

  % quarter circles of radius r in the theta plane and in the xy-plane
  \draw[dashed, tdplot_rotated_coords] (\rvec,0,0) arc (0:90:\rvec);
  \draw[dashed] (\rvec,0,0) arc (0:90:\rvec);
\end{tikzpicture}
