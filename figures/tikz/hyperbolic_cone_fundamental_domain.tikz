\begin{tikzpicture}[>=Latex,line cap=round,line join=round,scale=0.8]
  % Positive cone in a Lorentzian vector space.
  \draw[thick] (-4,3.2) ellipse (4 and 0.9);
  \draw[thick] (-4,3.2) -- (0,-5.2);
  \draw[thick] (4,3.2) -- (0,-5.2);
  \node[right] at (4.2,2.8) {$\cC$};

  % A fundamental chamber P and several reflected images.
  \fill[blue!15] (-2.2,3.6) -- (-0.2,1.75) -- (2.7,3.55) -- cycle;
  \draw[blue!70!black,very thick] (-2.2,3.6) -- (-0.2,1.75) -- (2.7,3.55) -- cycle;
  \draw[blue!70!black,very thick] (-2.2,3.6) -- (0,-5.2);
  \draw[blue!70!black,very thick] (-0.2,1.75) -- (0,-5.2);
  \draw[blue!70!black,very thick] (2.7,3.55) -- (0,-5.2);
  \node[blue!70!black] at (0.1,3.05) {$P$};

  \foreach \a/\b in {-3.8/-2.2,-2.2/-0.2,-0.2/2.7,2.7/3.9} {
    \draw[blue!35] (\a,3.25) -- (0,-5.2);
    \draw[blue!35] (\b,3.25) -- (0,-5.2);
  }

  % Reflection arrows indicating the Coxeter fan.
  \draw[->,thick] (-1.3,2.3) .. controls (-2.0,1.9) and (-2.6,2.0) .. (-3.0,2.45);
  \draw[->,thick] (1.15,2.25) .. controls (1.9,1.85) and (2.55,2.0) .. (3.0,2.45);
  \draw[->,thick] (0.25,2.55) .. controls (0.75,3.1) and (0.75,3.7) .. (0.3,4.05);

  \node[below] at (0,-5.35) {$0$};
\end{tikzpicture}
