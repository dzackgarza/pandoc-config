\begin{tikzpicture}[scale=0.8]
  % Positive cone in a Lorentzian vector space.
  \coordinate (0) at (0, -5.2);
  \draw[ias boundary] (-4, 3.2) ellipse (4 and 0.9);
  \draw[ias boundary] (-4, 3.2) -- (0) -- (4, 3.2);
  \node[right] at (4.2, 2.8) {$\cC$};

  % A fundamental chamber P, the cone over it, and several reflected images.
  \foreach \x in {-3.8, -2.2, -0.2, 2.7, 3.9}
    \draw[ias edge, draw=dzg accent!35] (\x, 3.25) -- (0);
  \draw[polygon region] (-2.2, 3.6) -- (-0.2, 1.75) -- (2.7, 3.55) -- cycle;
  \draw[fan ray, -] (-2.2, 3.6) -- (-0.2, 1.75) -- (2.7, 3.55) -- cycle;
  \foreach \p in {(-2.2, 3.6), (-0.2, 1.75), (2.7, 3.55)}
    \draw[fan ray, -] \p -- (0);
  \node[text=dzg accent] at (0.1, 3.05) {$P$};

  % Reflection arrows indicating the Coxeter fan.
  \draw[->] (-1.3, 2.3) to[curve through={(-2.26, 2.06)}] (-3.0, 2.45);
  \draw[->] (1.15, 2.25) to[curve through={(2.19, 2.03)}] (3.0, 2.45);
  \draw[->] (0.25, 2.55) to[curve through={(0.63, 3.38)}] (0.3, 4.05);

  \node[below] at (0) {$0$};
\end{tikzpicture}
