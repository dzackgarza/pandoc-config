% An arithmetic quotient F and its Baily-Borel compactification F^BB, drawn as
% the same blob with its two cusps marked.
\begin{tikzpicture}[scale=0.85]
  \foreach \x/\name in {0/F, 9.5/{F^{\mathrm{BB}}}} {
    \begin{scope}[xshift=\x cm]
      \coordinate (w) at (0,0);
      \coordinate (e) at (6,0.6);
      \draw[moduli blob, densely dashed] (w) to[bend left=35] (e)
        to[bend left=35] (w) -- cycle;
      \draw[curve component] (2.9,0.95)
        to[curve through={(2.42,-0.14)}] (2.8,-1.0);
      \draw[curve component] (2.45,0.45)
        to[curve through={(2.94,-0.21)}] (2.65,-0.8);
      \draw[densely dotted] ([xshift=-0.2cm]w) circle (0.18);
      \draw[densely dotted] ([xshift=0.2cm]e) circle (0.18);
      \node at (3,-1.9) {$\name$};
    \end{scope}
  }
  \draw[morphism] (6.7,0.3) -- node[above, font=\small] {adjoin cusps} (8.7,0.3);
\end{tikzpicture}
