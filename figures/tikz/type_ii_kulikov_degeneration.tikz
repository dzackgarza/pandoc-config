\begin{tikzpicture}[scale=0.95, label distance=2mm]
  % Chain of components in a Type II Kulikov central fibre: rational ends and
  % E x P^1 in the middle, glued along double curves E.
  \node[kulikov component, minimum width=1.65cm, minimum height=2.4cm,
    label=above:{$V_1$}, label={[name=type]below:rational}] (V1) {};
  \foreach \N/\prev/\lab in {V2/V1/V_2, V3/V2/V_3}
    \node[kulikov component, fill=dzg singular!10, minimum width=1.65cm,
      minimum height=2.4cm, right=0pt of \prev, label=above:{$\lab$},
      label=below:{$E\times\PP^1$}] (\N) {};
  \node[right=0.6cm of V3] (dots) {$\cdots$};
  \node[kulikov component, fill=dzg singular!10, minimum width=1.65cm,
    minimum height=2.4cm, right=0.6cm of dots, label=above:{$V_{n-1}$},
    label=below:{$E\times\PP^1$}] (Vm) {};
  \node[kulikov component, minimum width=1.65cm, minimum height=2.4cm,
    right=0pt of Vm, label=above:{$V_n$}, label=below:{rational}] (Vn) {};

  % Curved top and bottom profiles suggest ruled or rational components.
  \foreach \N in {V1, V2, V3, Vm, Vn} {
    \draw[ias edge] (\N.north west) to[curve through={([yshift=1.7mm] \N.north)}]
      (\N.north east);
    \draw[ias edge] (\N.south west) to[curve through={([yshift=-1.7mm] \N.south)}]
      (\N.south east);
  }

  % Double curves between adjacent components.
  \foreach \N in {V1, V2, Vm}
    \draw[double curve] (\N.north east) -- node[rotate=90, fill=white, inner sep=1pt]
      {$E$} (\N.south east);
  \draw[double curve, dashed] (Vm.north west) -- (Vm.south west);

  \coordinate[below=2mm of type.south] (dual row);
  \draw[|-|] (V1 |- dual row) -- node[below] {dual complex $\bD^1$}
    (Vn |- dual row);
\end{tikzpicture}
